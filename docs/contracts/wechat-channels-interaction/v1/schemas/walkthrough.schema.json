{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "walkthrough.schema.json",
  "title": "AIDCP Interaction Contract Walkthrough v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["flowId", "channel", "purpose", "steps", "finalAssertions"],
  "properties": {
    "flowId": { "$ref": "common.schema.json#/$defs/Id" },
    "channel": { "$ref": "common.schema.json#/$defs/Channel" },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 512 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "actor", "fixture", "expect"],
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "actor": { "enum": ["edge", "cloud", "customer_api", "console", "ai"] },
          "fixture": { "type": "string", "pattern": "^\\.\\./(?:ws|customer-api|internal-api|ai)/[a-z0-9-]+\\.json$" },
          "expect": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": { "type": "string", "minLength": 1, "maxLength": 512 }
          }
        }
      }
    },
    "finalAssertions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    }
  }
}
