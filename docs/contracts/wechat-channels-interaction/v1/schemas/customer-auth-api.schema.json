{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "customer-auth-api.schema.json",
  "title": "AIDCP Customer Interaction API v1",
  "anyOf": [
    { "$ref": "#/$defs/InteractionListResponse" },
    { "$ref": "#/$defs/InteractionDetailResponse" },
    { "$ref": "#/$defs/JobResponse" },
    { "$ref": "#/$defs/AcceptedActionResponse" },
    { "$ref": "#/$defs/OffboardResponse" },
    { "$ref": "#/$defs/DraftUpdateRequest" },
    { "$ref": "#/$defs/JobMutationRequest" },
    { "$ref": "#/$defs/EscalateRequest" },
    { "$ref": "#/$defs/SyncActionRequest" },
    { "$ref": "#/$defs/TestResetRequest" },
    { "$ref": "#/$defs/TestResetResponse" },
    { "$ref": "#/$defs/BrowserControlRequest" },
    { "$ref": "#/$defs/ReadControlsRequest" },
    { "$ref": "#/$defs/ReadControlsResponse" },
    { "$ref": "#/$defs/EmptyRequest" },
    { "$ref": "common.schema.json#/$defs/ErrorEnvelope" }
  ],
  "$defs": {
    "EffectiveCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commentsRead", "commentsReply", "dmRead", "dmSendText", "dmSendImage"],
      "properties": {
        "commentsRead": { "type": "boolean" },
        "commentsReply": { "type": "boolean" },
        "dmRead": { "type": "boolean" },
        "dmSendText": { "type": "boolean" },
        "dmSendImage": { "const": false }
      }
    },
    "AuthSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "browserState", "reasonCode", "checkedAt", "capabilities", "identity", "runtimeControls"],
      "properties": {
        "status": { "$ref": "common.schema.json#/$defs/AuthStatus" },
        "browserState": { "$ref": "common.schema.json#/$defs/BrowserState" },
        "reasonCode": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/ErrorCode" },
            { "type": "null" }
          ]
        },
        "checkedAt": { "$ref": "common.schema.json#/$defs/Timestamp" },
        "capabilities": { "$ref": "#/$defs/EffectiveCapabilities" },
        "identity": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["displayName", "identityHash"],
              "properties": {
                "displayName": { "type": "string", "minLength": 1, "maxLength": 256 },
                "identityHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
              }
            },
            { "type": "null" }
          ]
        },
        "runtimeControls": { "$ref": "#/$defs/RuntimeControlsProjection" }
      }
    },
    "RuntimeControlsProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storedVersion", "edgeAppliedVersion", "applicationStatus", "stored"],
      "properties": {
        "storedVersion": { "type": "integer", "minimum": 0 },
        "edgeAppliedVersion": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "applicationStatus": { "enum": ["applied", "pending", "stale"] },
        "stored": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commentsReadEnabled", "commentsReplyEnabled", "dmReadEnabled", "dmSendTextEnabled", "dmSendImageEnabled", "writePaused"],
          "properties": {
            "commentsReadEnabled": { "type": "boolean" },
            "commentsReplyEnabled": { "type": "boolean" },
            "dmReadEnabled": { "type": "boolean" },
            "dmSendTextEnabled": { "type": "boolean" },
            "dmSendImageEnabled": { "const": false },
            "writePaused": { "type": "boolean" }
          }
        }
      }
    },
    "ReplyConfigProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "currentVersion", "draftVersion", "publishedVersion"],
      "properties": {
        "status": { "enum": ["missing", "draft_only", "published", "unknown"] },
        "currentVersion": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "draftVersion": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        },
        "publishedVersion": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        }
      }
    },
    "SyncFreshnessEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observedAt", "receivedAt"],
      "properties": {
        "observedAt": { "$ref": "common.schema.json#/$defs/Timestamp" },
        "receivedAt": { "$ref": "common.schema.json#/$defs/Timestamp" }
      }
    },
    "SyncFreshnessProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comment", "dm"],
      "properties": {
        "comment": {
          "oneOf": [
            { "$ref": "#/$defs/SyncFreshnessEvidence" },
            { "type": "null" }
          ]
        },
        "dm": {
          "oneOf": [
            { "$ref": "#/$defs/SyncFreshnessEvidence" },
            { "type": "null" }
          ]
        }
      }
    },
    "InteractionListItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threadId",
        "messageId",
        "channel",
        "participantName",
        "participantAvatarUrl",
        "previewText",
        "sourceTitle",
        "lastMessageAt",
        "unread",
        "riskLevel",
        "jobState",
        "jobVersion"
      ],
      "properties": {
        "threadId": { "$ref": "common.schema.json#/$defs/Id" },
        "messageId": { "$ref": "common.schema.json#/$defs/Id" },
        "channel": { "$ref": "common.schema.json#/$defs/Channel" },
        "participantName": { "$ref": "common.schema.json#/$defs/NullableString" },
        "participantAvatarUrl": {
          "oneOf": [
            { "type": "string", "format": "uri", "maxLength": 2048 },
            { "type": "null" }
          ]
        },
        "previewText": { "$ref": "common.schema.json#/$defs/NullableString" },
        "sourceTitle": { "$ref": "common.schema.json#/$defs/NullableString" },
        "lastMessageAt": { "$ref": "common.schema.json#/$defs/Timestamp" },
        "unread": { "type": "boolean" },
        "riskLevel": { "$ref": "common.schema.json#/$defs/RiskLevel" },
        "jobState": { "$ref": "common.schema.json#/$defs/ReplyJobState" },
        "jobVersion": { "type": "integer", "minimum": 0 }
      }
    },
    "InteractionListResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "meta"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["envKey", "accountId", "platform", "auth", "replyConfig", "testTools", "syncFreshness", "items", "nextCursor"],
          "properties": {
            "envKey": { "$ref": "common.schema.json#/$defs/Id" },
            "accountId": { "$ref": "common.schema.json#/$defs/Id" },
            "platform": { "$ref": "common.schema.json#/$defs/Platform" },
            "auth": { "$ref": "#/$defs/AuthSummary" },
            "replyConfig": { "$ref": "#/$defs/ReplyConfigProjection" },
            "testTools": {
              "type": "object",
              "additionalProperties": false,
              "required": ["dataResetEnabled"],
              "properties": { "dataResetEnabled": { "type": "boolean" } }
            },
            "syncFreshness": { "$ref": "#/$defs/SyncFreshnessProjection" },
            "items": {
              "type": "array",
              "maxItems": 100,
              "items": { "$ref": "#/$defs/InteractionListItem" }
            },
            "nextCursor": { "$ref": "common.schema.json#/$defs/NullableString" }
          }
        },
        "meta": { "$ref": "common.schema.json#/$defs/ResponseMeta" }
      }
    },
    "InteractionDetailResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "meta"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "envKey",
            "accountId",
            "platform",
            "auth",
            "replyConfig",
            "syncFreshness",
            "thread",
            "messages",
            "replyJob",
            "sendAttempt",
            "nextCursor"
          ],
          "properties": {
            "envKey": { "$ref": "common.schema.json#/$defs/Id" },
            "accountId": { "$ref": "common.schema.json#/$defs/Id" },
            "platform": { "$ref": "common.schema.json#/$defs/Platform" },
            "auth": { "$ref": "#/$defs/AuthSummary" },
            "replyConfig": { "$ref": "#/$defs/ReplyConfigProjection" },
            "syncFreshness": { "$ref": "#/$defs/SyncFreshnessProjection" },
            "thread": { "$ref": "domain.schema.json#/$defs/ThreadView" },
            "messages": {
              "type": "array",
              "maxItems": 100,
              "items": { "$ref": "domain.schema.json#/$defs/MessageView" }
            },
            "replyJob": {
              "oneOf": [
                { "$ref": "domain.schema.json#/$defs/ReplyJobView" },
                { "type": "null" }
              ]
            },
            "sendAttempt": {
              "oneOf": [
                { "$ref": "domain.schema.json#/$defs/SendAttemptView" },
                { "type": "null" }
              ]
            },
            "nextCursor": { "$ref": "common.schema.json#/$defs/NullableString" }
          }
        },
        "meta": { "$ref": "common.schema.json#/$defs/ResponseMeta" }
      }
    },
    "JobResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "meta"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["envKey", "accountId", "job"],
          "properties": {
            "envKey": { "$ref": "common.schema.json#/$defs/Id" },
            "accountId": { "$ref": "common.schema.json#/$defs/Id" },
            "job": { "$ref": "domain.schema.json#/$defs/ReplyJobView" }
          }
        },
        "meta": { "$ref": "common.schema.json#/$defs/ResponseMeta" }
      }
    },
    "AcceptedActionResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "meta"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["envKey", "accountId", "action", "actionRequestId", "status"],
          "properties": {
            "envKey": { "$ref": "common.schema.json#/$defs/Id" },
            "accountId": { "$ref": "common.schema.json#/$defs/Id" },
            "action": { "enum": ["sync", "auth_reopen", "browser_control"] },
            "browserAction": { "enum": ["open", "close"] },
            "actionRequestId": { "$ref": "common.schema.json#/$defs/Id" },
            "status": { "const": "accepted" }
          }
        },
        "meta": { "$ref": "common.schema.json#/$defs/ResponseMeta" }
      }
    },
    "OffboardResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "meta"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["offboardId", "envKey", "accountId", "state", "reason", "requestedAt", "purgeDueAt"],
          "properties": {
            "offboardId": { "$ref": "common.schema.json#/$defs/Id" },
            "envKey": { "$ref": "common.schema.json#/$defs/Id" },
            "accountId": { "$ref": "common.schema.json#/$defs/Id" },
            "state": { "enum": ["pending_edge", "dispatched", "tombstoned", "purged"] },
            "reason": { "enum": ["environment_unbind", "customer_terminated", "admin_revoked"] },
            "requestedAt": { "$ref": "common.schema.json#/$defs/Timestamp" },
            "purgeDueAt": { "$ref": "common.schema.json#/$defs/Timestamp" }
          }
        },
        "meta": { "$ref": "common.schema.json#/$defs/ResponseMeta" }
      }
    },
    "DraftUpdateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedVersion", "finalText"],
      "properties": {
        "expectedVersion": { "type": "integer", "minimum": 0 },
        "finalText": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "JobMutationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedVersion"],
      "properties": {
        "expectedVersion": { "type": "integer", "minimum": 0 }
      }
    },
    "EscalateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedVersion", "reason"],
      "properties": {
        "expectedVersion": { "type": "integer", "minimum": 0 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "SyncActionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "scopeExternalId"],
      "properties": {
        "channel": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/Channel" },
            { "type": "null" }
          ]
        },
        "scopeExternalId": { "$ref": "common.schema.json#/$defs/NullableId" }
      }
    },
    "TestResetRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel"],
      "properties": { "channel": { "$ref": "common.schema.json#/$defs/Channel" } }
    },
    "TestResetResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "meta"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["envKey", "accountId", "channel", "action", "actionRequestId", "status", "deleted"],
          "properties": {
            "envKey": { "$ref": "common.schema.json#/$defs/Id" },
            "accountId": { "$ref": "common.schema.json#/$defs/Id" },
            "channel": { "$ref": "common.schema.json#/$defs/Channel" },
            "action": { "const": "test_reset" },
            "actionRequestId": { "$ref": "common.schema.json#/$defs/Id" },
            "status": { "const": "accepted" },
            "deleted": {
              "type": "object",
              "additionalProperties": false,
              "required": ["threads", "syncBatches", "syncCursors"],
              "properties": {
                "threads": { "type": "integer", "minimum": 0 },
                "syncBatches": { "type": "integer", "minimum": 0 },
                "syncCursors": { "type": "integer", "minimum": 0 }
              }
            }
          }
        },
        "meta": { "$ref": "common.schema.json#/$defs/ResponseMeta" }
      }
    },
    "BrowserControlRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": { "enum": ["open", "close"] }
      }
    },
    "ReadControlsRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedVersion", "commentsReadEnabled", "dmReadEnabled"],
      "properties": {
        "expectedVersion": { "type": "integer", "minimum": 0 },
        "commentsReadEnabled": { "type": "boolean" },
        "dmReadEnabled": { "type": "boolean" }
      }
    },
    "ReadControlsResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "meta"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["envKey", "accountId", "platform", "auth", "replyConfig", "edgeDelivery"],
          "properties": {
            "envKey": { "$ref": "common.schema.json#/$defs/Id" },
            "accountId": { "$ref": "common.schema.json#/$defs/Id" },
            "platform": { "$ref": "common.schema.json#/$defs/Platform" },
            "auth": { "$ref": "#/$defs/AuthSummary" },
            "replyConfig": { "$ref": "#/$defs/ReplyConfigProjection" },
            "edgeDelivery": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "delivered"],
              "properties": {
                "status": { "enum": ["enqueued", "deferred"] },
                "delivered": { "type": "integer", "minimum": 0, "maximum": 1 }
              }
            }
          }
        },
        "meta": { "$ref": "common.schema.json#/$defs/ResponseMeta" }
      }
    },
    "EmptyRequest": {
      "type": "object",
      "maxProperties": 0
    }
  }
}
