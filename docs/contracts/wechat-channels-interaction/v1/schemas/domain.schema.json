{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "domain.schema.json",
  "title": "AIDCP Inbound Interaction Domain v1",
  "oneOf": [
    { "$ref": "#/$defs/SyncThread" },
    { "$ref": "#/$defs/SyncMessage" },
    { "$ref": "#/$defs/ThreadView" },
    { "$ref": "#/$defs/MessageView" },
    { "$ref": "#/$defs/ReplyJobView" },
    { "$ref": "#/$defs/SendAttemptView" }
  ],
  "$defs": {
    "ParticipantSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["externalId", "displayName", "avatarUrl"],
      "properties": {
        "externalId": { "$ref": "common.schema.json#/$defs/Id" },
        "displayName": { "$ref": "common.schema.json#/$defs/NullableString" },
        "avatarUrl": {
          "oneOf": [
            { "type": "string", "format": "uri", "maxLength": 2048 },
            { "type": "null" }
          ]
        }
      }
    },
    "AttachmentMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mimeType", "width", "height", "url"],
      "properties": {
        "mimeType": { "$ref": "common.schema.json#/$defs/NullableString" },
        "width": {
          "oneOf": [
            { "type": "integer", "minimum": 1, "maximum": 50000 },
            { "type": "null" }
          ]
        },
        "height": {
          "oneOf": [
            { "type": "integer", "minimum": 1, "maximum": 50000 },
            { "type": "null" }
          ]
        },
        "url": {
          "oneOf": [
            { "type": "string", "format": "uri", "maxLength": 2048 },
            { "type": "null" }
          ]
        }
      }
    },
    "SanitizedMeta": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {
        "oneOf": [
          { "type": "string", "maxLength": 512 },
          { "type": "number" },
          { "type": "boolean" },
          { "type": "null" }
        ]
      }
    },
    "SyncThread": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "externalThreadId",
        "sourceExternalId",
        "sourceTitle",
        "sourceCoverUrl",
        "participant",
        "updatedAt"
      ],
      "properties": {
        "externalThreadId": { "$ref": "common.schema.json#/$defs/Id" },
        "sourceExternalId": { "$ref": "common.schema.json#/$defs/NullableId" },
        "sourceTitle": { "$ref": "common.schema.json#/$defs/NullableString" },
        "sourceCoverUrl": {
          "oneOf": [
            { "type": "string", "format": "uri", "maxLength": 2048 },
            { "type": "null" }
          ]
        },
        "participant": {
          "oneOf": [
            { "$ref": "#/$defs/ParticipantSnapshot" },
            { "type": "null" }
          ]
        },
        "updatedAt": { "$ref": "common.schema.json#/$defs/Timestamp" }
      }
    },
    "SyncMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "externalThreadId",
        "externalMessageId",
        "direction",
        "externalParentId",
        "externalRootId",
        "messageType",
        "contentText",
        "attachmentMeta",
        "lifecycle",
        "platformCreatedAt",
        "rawMetaSanitized"
      ],
      "properties": {
        "externalThreadId": { "$ref": "common.schema.json#/$defs/Id" },
        "externalMessageId": { "$ref": "common.schema.json#/$defs/Id" },
        "direction": { "$ref": "common.schema.json#/$defs/Direction" },
        "externalParentId": { "$ref": "common.schema.json#/$defs/NullableId" },
        "externalRootId": { "$ref": "common.schema.json#/$defs/NullableId" },
        "messageType": { "$ref": "common.schema.json#/$defs/MessageType" },
        "contentText": { "$ref": "common.schema.json#/$defs/NullableString" },
        "attachmentMeta": {
          "oneOf": [
            { "$ref": "#/$defs/AttachmentMeta" },
            { "type": "null" }
          ]
        },
        "lifecycle": { "$ref": "common.schema.json#/$defs/MessageLifecycle" },
        "platformCreatedAt": { "$ref": "common.schema.json#/$defs/Timestamp" },
        "rawMetaSanitized": { "$ref": "#/$defs/SanitizedMeta" }
      }
    },
    "ThreadStatus": {
      "enum": ["open", "waiting_review", "replied", "escalated", "closed"]
    },
    "ThreadView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "platform",
        "accountId",
        "envKey",
        "channel",
        "externalThreadId",
        "sourceExternalId",
        "sourceTitle",
        "sourceCoverUrl",
        "participant",
        "status",
        "lastMessageAt",
        "lastSyncedAt"
      ],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/Id" },
        "platform": { "$ref": "common.schema.json#/$defs/Platform" },
        "accountId": { "$ref": "common.schema.json#/$defs/Id" },
        "envKey": { "$ref": "common.schema.json#/$defs/Id" },
        "channel": { "$ref": "common.schema.json#/$defs/Channel" },
        "externalThreadId": { "$ref": "common.schema.json#/$defs/Id" },
        "sourceExternalId": { "$ref": "common.schema.json#/$defs/NullableId" },
        "sourceTitle": { "$ref": "common.schema.json#/$defs/NullableString" },
        "sourceCoverUrl": {
          "oneOf": [
            { "type": "string", "format": "uri", "maxLength": 2048 },
            { "type": "null" }
          ]
        },
        "participant": {
          "oneOf": [
            { "$ref": "#/$defs/ParticipantSnapshot" },
            { "type": "null" }
          ]
        },
        "status": { "$ref": "#/$defs/ThreadStatus" },
        "lastMessageAt": { "$ref": "common.schema.json#/$defs/Timestamp" },
        "lastSyncedAt": { "$ref": "common.schema.json#/$defs/Timestamp" }
      }
    },
    "MessageView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "threadId",
        "direction",
        "externalMessageId",
        "externalParentId",
        "externalRootId",
        "messageType",
        "contentText",
        "attachmentMeta",
        "lifecycle",
        "platformCreatedAt"
      ],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/Id" },
        "threadId": { "$ref": "common.schema.json#/$defs/Id" },
        "direction": { "$ref": "common.schema.json#/$defs/Direction" },
        "externalMessageId": { "$ref": "common.schema.json#/$defs/Id" },
        "externalParentId": { "$ref": "common.schema.json#/$defs/NullableId" },
        "externalRootId": { "$ref": "common.schema.json#/$defs/NullableId" },
        "messageType": { "$ref": "common.schema.json#/$defs/MessageType" },
        "contentText": { "$ref": "common.schema.json#/$defs/NullableString" },
        "attachmentMeta": {
          "oneOf": [
            { "$ref": "#/$defs/AttachmentMeta" },
            { "type": "null" }
          ]
        },
        "lifecycle": { "$ref": "common.schema.json#/$defs/MessageLifecycle" },
        "platformCreatedAt": { "$ref": "common.schema.json#/$defs/Timestamp" }
      }
    },
    "TemplateRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["templateId", "templateVersion"],
      "properties": {
        "templateId": { "$ref": "common.schema.json#/$defs/NullableId" },
        "templateVersion": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        }
      }
    },
    "ReplyJobView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "inboundMessageId",
        "state",
        "version",
        "matchedRuleId",
        "configVersion",
        "template",
        "renderedText",
        "polishedText",
        "finalText",
        "riskLevel",
        "riskReasons",
        "approvalActor",
        "approvedAt",
        "idempotencyKey",
        "updatedAt"
      ],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/Id" },
        "inboundMessageId": { "$ref": "common.schema.json#/$defs/Id" },
        "state": { "$ref": "common.schema.json#/$defs/ReplyJobState" },
        "version": { "type": "integer", "minimum": 0 },
        "matchedRuleId": { "$ref": "common.schema.json#/$defs/NullableId" },
        "configVersion": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        },
        "template": { "$ref": "#/$defs/TemplateRef" },
        "renderedText": { "$ref": "common.schema.json#/$defs/NullableString" },
        "polishedText": { "$ref": "common.schema.json#/$defs/NullableString" },
        "finalText": { "$ref": "common.schema.json#/$defs/NullableString" },
        "riskLevel": { "$ref": "common.schema.json#/$defs/RiskLevel" },
        "riskReasons": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "common.schema.json#/$defs/RiskTag" },
          "uniqueItems": true
        },
        "approvalActor": { "$ref": "common.schema.json#/$defs/NullableId" },
        "approvedAt": { "$ref": "common.schema.json#/$defs/NullableTimestamp" },
        "idempotencyKey": {
          "oneOf": [
            { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            { "type": "null" }
          ]
        },
        "updatedAt": { "$ref": "common.schema.json#/$defs/Timestamp" }
      }
    },
    "AttemptStatus": {
      "enum": ["created", "dispatched", "confirmed", "failed", "ambiguous"]
    },
    "VerificationStatus": {
      "enum": ["not_needed", "pending", "confirmed", "not_found"]
    },
    "SendAttemptView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "replyJobId",
        "attemptNo",
        "idempotencyKey",
        "status",
        "verificationStatus",
        "externalMessageId",
        "errorCode",
        "startedAt",
        "finishedAt"
      ],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/Id" },
        "replyJobId": { "$ref": "common.schema.json#/$defs/Id" },
        "attemptNo": { "type": "integer", "minimum": 1 },
        "idempotencyKey": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "status": { "$ref": "#/$defs/AttemptStatus" },
        "verificationStatus": { "$ref": "#/$defs/VerificationStatus" },
        "externalMessageId": { "$ref": "common.schema.json#/$defs/NullableId" },
        "errorCode": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/ErrorCode" },
            { "type": "null" }
          ]
        },
        "startedAt": { "$ref": "common.schema.json#/$defs/Timestamp" },
        "finishedAt": { "$ref": "common.schema.json#/$defs/NullableTimestamp" }
      }
    }
  }
}
