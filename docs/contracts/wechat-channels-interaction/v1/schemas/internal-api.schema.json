{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "internal-api.schema.json",
  "title": "AIDCP Internal Interaction Configuration API v1",
  "anyOf": [
    { "$ref": "#/$defs/RuntimeControlsResponse" },
    { "$ref": "#/$defs/PolicyResponse" },
    { "$ref": "#/$defs/TemplateListResponse" },
    { "$ref": "#/$defs/RuleListResponse" },
    { "$ref": "#/$defs/ProfileResponse" },
    { "$ref": "#/$defs/PreviewContextsResponse" },
    { "$ref": "#/$defs/InitializeResponse" },
    { "$ref": "#/$defs/PublishResponse" },
    { "$ref": "#/$defs/PreviewResponse" },
    { "$ref": "#/$defs/AuditResponse" },
    { "$ref": "#/$defs/RuntimeControlsUpdate" },
    { "$ref": "#/$defs/PolicyUpdate" },
    { "$ref": "#/$defs/TemplateWrite" },
    { "$ref": "#/$defs/RuleWrite" },
    { "$ref": "#/$defs/ProfileWrite" },
    { "$ref": "#/$defs/InitializeRequest" },
    { "$ref": "#/$defs/PublishRequest" },
    { "$ref": "#/$defs/PreviewRequest" },
    { "$ref": "common.schema.json#/$defs/ErrorEnvelope" }
  ],
  "$defs": {
    "RuntimeControls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accountId",
        "platform",
        "version",
        "commentsReadEnabled",
        "commentsReplyEnabled",
        "dmReadEnabled",
        "dmSendTextEnabled",
        "dmSendImageEnabled",
        "writePaused",
        "updatedAt",
        "updatedBy"
      ],
      "properties": {
        "accountId": { "$ref": "common.schema.json#/$defs/Id" },
        "platform": { "$ref": "common.schema.json#/$defs/Platform" },
        "version": { "type": "integer", "minimum": 0 },
        "commentsReadEnabled": { "type": "boolean" },
        "commentsReplyEnabled": { "type": "boolean" },
        "dmReadEnabled": { "type": "boolean" },
        "dmSendTextEnabled": { "type": "boolean" },
        "dmSendImageEnabled": { "const": false },
        "writePaused": { "type": "boolean" },
        "updatedAt": { "$ref": "common.schema.json#/$defs/Timestamp" },
        "updatedBy": { "$ref": "common.schema.json#/$defs/Id" },
        "edgeDelivery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "delivered"],
          "properties": {
            "status": { "enum": ["enqueued", "deferred"] },
            "delivered": { "type": "integer", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "PolicyChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "aiPolishEnabled", "allowAutoSend"],
      "properties": {
        "enabled": { "type": "boolean" },
        "aiPolishEnabled": { "type": "boolean" },
        "allowAutoSend": { "type": "boolean" }
      }
    },
    "RateLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accountPerMinute",
        "accountPerHour",
        "accountPerDay",
        "threadCooldownSeconds",
        "newLoginCooldownSeconds",
        "consecutiveFailureLimit"
      ],
      "properties": {
        "accountPerMinute": { "type": "integer", "minimum": 0, "maximum": 60 },
        "accountPerHour": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "accountPerDay": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "threadCooldownSeconds": { "type": "integer", "minimum": 0, "maximum": 604800 },
        "newLoginCooldownSeconds": { "type": "integer", "minimum": 0, "maximum": 604800 },
        "consecutiveFailureLimit": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "ReplyPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "generateDrafts", "sendReplies", "channels", "rateLimits"],
      "properties": {
        "mode": { "enum": ["draft_only", "review_before_send", "auto_safe"] },
        "generateDrafts": { "type": "boolean" },
        "sendReplies": { "type": "boolean" },
        "channels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["comment", "dm"],
          "properties": {
            "comment": { "$ref": "#/$defs/PolicyChannel" },
            "dm": { "$ref": "#/$defs/PolicyChannel" }
          }
        },
        "rateLimits": { "$ref": "#/$defs/RateLimits" }
      }
    },
    "TemplateVariable": {
      "enum": ["user_name", "video_title", "account_name", "support_channel"]
    },
    "ReplyTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "templateId",
        "channel",
        "name",
        "content",
        "enabled",
        "archived",
        "templateVersion",
        "variables",
        "updatedAt",
        "updatedBy"
      ],
      "properties": {
        "templateId": { "$ref": "common.schema.json#/$defs/Id" },
        "channel": { "$ref": "common.schema.json#/$defs/Channel" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "content": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "enabled": { "type": "boolean" },
        "archived": { "type": "boolean" },
        "templateVersion": { "type": "integer", "minimum": 1 },
        "variables": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/TemplateVariable" },
          "uniqueItems": true
        },
        "updatedAt": { "$ref": "common.schema.json#/$defs/Timestamp" },
        "updatedBy": { "$ref": "common.schema.json#/$defs/Id" }
      }
    },
    "WorkHours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timezone", "start", "end"],
      "properties": {
        "timezone": { "type": "string", "minLength": 1, "maxLength": 64 },
        "start": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
        "end": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" }
      }
    },
    "RuleConditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keywordsAny", "intentsAny", "sourceExternalIds", "messageTypes", "workHours"],
      "properties": {
        "keywordsAny": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 },
          "uniqueItems": true
        },
        "intentsAny": {
          "type": "array",
          "maxItems": 18,
          "items": { "$ref": "ai-roles.schema.json#/$defs/Intent" },
          "uniqueItems": true
        },
        "sourceExternalIds": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "common.schema.json#/$defs/Id" },
          "uniqueItems": true
        },
        "messageTypes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "common.schema.json#/$defs/MessageType" },
          "uniqueItems": true
        },
        "workHours": {
          "oneOf": [
            { "$ref": "#/$defs/WorkHours" },
            { "type": "null" }
          ]
        }
      }
    },
    "RuleActions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["templateId", "polish", "allowAutoSend", "forceHumanTags"],
      "properties": {
        "templateId": { "$ref": "common.schema.json#/$defs/Id" },
        "polish": { "type": "boolean" },
        "allowAutoSend": { "type": "boolean" },
        "forceHumanTags": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "common.schema.json#/$defs/RiskTag" },
          "uniqueItems": true
        }
      }
    },
    "ReplyRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "channel",
        "name",
        "priority",
        "enabled",
        "conditions",
        "actions",
        "updatedAt",
        "updatedBy"
      ],
      "properties": {
        "ruleId": { "$ref": "common.schema.json#/$defs/Id" },
        "channel": { "$ref": "common.schema.json#/$defs/Channel" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "priority": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "enabled": { "type": "boolean" },
        "conditions": { "$ref": "#/$defs/RuleConditions" },
        "actions": { "$ref": "#/$defs/RuleActions" },
        "updatedAt": { "$ref": "common.schema.json#/$defs/Timestamp" },
        "updatedBy": { "$ref": "common.schema.json#/$defs/Id" }
      }
    },
    "VariableFallbacks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_name", "video_title", "account_name", "support_channel"],
      "properties": {
        "user_name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "video_title": { "type": "string", "minLength": 1, "maxLength": 256 },
        "account_name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "support_channel": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "ReplyProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "selfName",
        "userAddress",
        "tone",
        "maxLength",
        "allowEmoji",
        "allowLinks",
        "blockedPhrases",
        "disallowedClaims",
        "requiredDisclaimer",
        "variableFallbacks"
      ],
      "properties": {
        "channel": { "$ref": "common.schema.json#/$defs/Channel" },
        "selfName": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userAddress": { "type": "string", "minLength": 1, "maxLength": 128 },
        "tone": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "enum": ["professional", "friendly", "concise"] },
          "uniqueItems": true
        },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 4000 },
        "allowEmoji": { "type": "boolean" },
        "allowLinks": { "type": "boolean" },
        "blockedPhrases": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 },
          "uniqueItems": true
        },
        "disallowedClaims": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 },
          "uniqueItems": true
        },
        "requiredDisclaimer": { "$ref": "common.schema.json#/$defs/NullableString" },
        "variableFallbacks": { "$ref": "#/$defs/VariableFallbacks" }
      }
    },
    "ConfigHead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountId", "platform", "currentVersion", "draftVersion", "publishedVersion", "updatedAt", "updatedBy"],
      "properties": {
        "accountId": { "$ref": "common.schema.json#/$defs/Id" },
        "platform": { "$ref": "common.schema.json#/$defs/Platform" },
        "currentVersion": { "type": "integer", "minimum": 0 },
        "draftVersion": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        },
        "publishedVersion": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        },
        "updatedAt": { "$ref": "common.schema.json#/$defs/Timestamp" },
        "updatedBy": { "$ref": "common.schema.json#/$defs/Id" }
      }
    },
    "RuntimeControlsResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "meta"],
      "properties": {
        "data": { "$ref": "#/$defs/RuntimeControls" },
        "meta": { "$ref": "common.schema.json#/$defs/ResponseMeta" }
      }
    },
    "PolicyResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "meta"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["head", "policy"],
          "properties": {
            "head": { "$ref": "#/$defs/ConfigHead" },
            "policy": { "$ref": "#/$defs/ReplyPolicy" }
          }
        },
        "meta": { "$ref": "common.schema.json#/$defs/ResponseMeta" }
      }
    },
    "InitializeResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "meta"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["head", "initializedVersion"],
          "properties": {
            "head": { "$ref": "#/$defs/ConfigHead" },
            "initializedVersion": { "type": "integer", "minimum": 1 }
          }
        },
        "meta": { "$ref": "common.schema.json#/$defs/ResponseMeta" }
      }
    },
    "TemplateListResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "meta"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accountId", "currentVersion", "items", "nextCursor"],
          "properties": {
            "accountId": { "$ref": "common.schema.json#/$defs/Id" },
            "currentVersion": { "type": "integer", "minimum": 0 },
            "items": {
              "type": "array",
              "maxItems": 100,
              "items": { "$ref": "#/$defs/ReplyTemplate" }
            },
            "nextCursor": { "$ref": "common.schema.json#/$defs/NullableString" }
          }
        },
        "meta": { "$ref": "common.schema.json#/$defs/ResponseMeta" }
      }
    },
    "RuleListResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "meta"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accountId", "currentVersion", "items", "nextCursor"],
          "properties": {
            "accountId": { "$ref": "common.schema.json#/$defs/Id" },
            "currentVersion": { "type": "integer", "minimum": 0 },
            "items": {
              "type": "array",
              "maxItems": 100,
              "items": { "$ref": "#/$defs/ReplyRule" }
            },
            "nextCursor": { "$ref": "common.schema.json#/$defs/NullableString" }
          }
        },
        "meta": { "$ref": "common.schema.json#/$defs/ResponseMeta" }
      }
    },
    "ProfileResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "meta"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accountId", "currentVersion", "profiles"],
          "properties": {
            "accountId": { "$ref": "common.schema.json#/$defs/Id" },
            "currentVersion": { "type": "integer", "minimum": 0 },
            "profiles": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "$ref": "#/$defs/ReplyProfile" }
            }
          }
        },
        "meta": { "$ref": "common.schema.json#/$defs/ResponseMeta" }
      }
    },
    "PreviewContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threadId", "messageId", "channel", "messageType", "userMessage", "userName", "videoTitle", "receivedAt"],
      "properties": {
        "threadId": { "$ref": "common.schema.json#/$defs/Id" },
        "messageId": { "$ref": "common.schema.json#/$defs/Id" },
        "channel": { "$ref": "common.schema.json#/$defs/Channel" },
        "messageType": { "$ref": "common.schema.json#/$defs/MessageType" },
        "userMessage": { "$ref": "common.schema.json#/$defs/NullableString" },
        "userName": { "$ref": "common.schema.json#/$defs/NullableString" },
        "videoTitle": { "$ref": "common.schema.json#/$defs/NullableString" },
        "receivedAt": { "$ref": "common.schema.json#/$defs/Timestamp" }
      }
    },
    "PreviewContextsResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "meta"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accountId", "items"],
          "properties": {
            "accountId": { "$ref": "common.schema.json#/$defs/Id" },
            "items": {
              "type": "array",
              "maxItems": 50,
              "items": { "$ref": "#/$defs/PreviewContext" }
            }
          }
        },
        "meta": { "$ref": "common.schema.json#/$defs/ResponseMeta" }
      }
    },
    "PublishResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "meta"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["head", "publishedAt", "publishedBy"],
          "properties": {
            "head": { "$ref": "#/$defs/ConfigHead" },
            "publishedAt": { "$ref": "common.schema.json#/$defs/Timestamp" },
            "publishedBy": { "$ref": "common.schema.json#/$defs/Id" }
          }
        },
        "meta": { "$ref": "common.schema.json#/$defs/ResponseMeta" }
      }
    },
    "PreviewResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "meta"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accountId", "configVersion", "matchedRule", "template", "polish", "risk", "action"],
          "properties": {
            "accountId": { "$ref": "common.schema.json#/$defs/Id" },
            "configVersion": { "type": "integer", "minimum": 1 },
            "matchedRule": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["ruleId", "reason"],
                  "properties": {
                    "ruleId": { "$ref": "common.schema.json#/$defs/Id" },
                    "reason": { "type": "string", "minLength": 1, "maxLength": 512 }
                  }
                },
                { "type": "null" }
              ]
            },
            "template": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["templateId", "templateVersion", "renderedText"],
                  "properties": {
                    "templateId": { "$ref": "common.schema.json#/$defs/Id" },
                    "templateVersion": { "type": "integer", "minimum": 1 },
                    "renderedText": { "type": "string", "minLength": 1, "maxLength": 4000 }
                  }
                },
                { "type": "null" }
              ]
            },
            "polish": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["before", "after", "fallbackUsed", "meaningChanged", "introducedClaims"],
                  "properties": {
                    "before": { "type": "string", "minLength": 1, "maxLength": 4000 },
                    "after": { "type": "string", "minLength": 1, "maxLength": 4000 },
                    "fallbackUsed": { "type": "boolean" },
                    "meaningChanged": { "type": "boolean" },
                    "introducedClaims": {
                      "type": "array",
                      "maxItems": 16,
                      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
                    }
                  }
                },
                { "type": "null" }
              ]
            },
            "risk": {
              "type": "object",
              "additionalProperties": false,
              "required": ["level", "tags", "reasons"],
              "properties": {
                "level": { "$ref": "common.schema.json#/$defs/RiskLevel" },
                "tags": {
                  "type": "array",
                  "maxItems": 32,
                  "items": { "$ref": "common.schema.json#/$defs/RiskTag" },
                  "uniqueItems": true
                },
                "reasons": {
                  "type": "array",
                  "maxItems": 16,
                  "items": { "type": "string", "minLength": 1, "maxLength": 256 }
                }
              }
            },
            "action": { "enum": ["draft", "review_required", "would_auto_send", "no_match", "blocked"] }
          }
        },
        "meta": { "$ref": "common.schema.json#/$defs/ResponseMeta" }
      }
    },
    "AuditItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "actor", "action", "configVersion", "entityType", "entityId", "summary", "createdAt"],
      "properties": {
        "eventId": { "$ref": "common.schema.json#/$defs/Id" },
        "actor": { "$ref": "common.schema.json#/$defs/Id" },
        "action": { "enum": ["draft_saved", "template_archived", "config_initialized", "config_published", "previewed"] },
        "configVersion": { "type": "integer", "minimum": 1 },
        "entityType": { "enum": ["policy", "template", "rule", "profile", "config", "preview"] },
        "entityId": { "$ref": "common.schema.json#/$defs/NullableId" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 512 },
        "createdAt": { "$ref": "common.schema.json#/$defs/Timestamp" }
      }
    },
    "AuditResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "meta"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accountId", "items", "nextCursor"],
          "properties": {
            "accountId": { "$ref": "common.schema.json#/$defs/Id" },
            "items": {
              "type": "array",
              "maxItems": 100,
              "items": { "$ref": "#/$defs/AuditItem" }
            },
            "nextCursor": { "$ref": "common.schema.json#/$defs/NullableString" }
          }
        },
        "meta": { "$ref": "common.schema.json#/$defs/ResponseMeta" }
      }
    },
    "RuntimeControlsUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedVersion",
        "commentsReadEnabled",
        "commentsReplyEnabled",
        "dmReadEnabled",
        "dmSendTextEnabled",
        "dmSendImageEnabled",
        "writePaused"
      ],
      "properties": {
        "expectedVersion": { "type": "integer", "minimum": 0 },
        "commentsReadEnabled": { "type": "boolean" },
        "commentsReplyEnabled": { "type": "boolean" },
        "dmReadEnabled": { "type": "boolean" },
        "dmSendTextEnabled": { "type": "boolean" },
        "dmSendImageEnabled": { "const": false },
        "writePaused": { "type": "boolean" }
      }
    },
    "PolicyUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedVersion", "policy"],
      "properties": {
        "expectedVersion": { "type": "integer", "minimum": 0 },
        "policy": { "$ref": "#/$defs/ReplyPolicy" }
      }
    },
    "TemplateWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedVersion", "template"],
      "properties": {
        "expectedVersion": { "type": "integer", "minimum": 0 },
        "template": { "$ref": "#/$defs/ReplyTemplate" }
      }
    },
    "RuleWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedVersion", "rule"],
      "properties": {
        "expectedVersion": { "type": "integer", "minimum": 0 },
        "rule": { "$ref": "#/$defs/ReplyRule" }
      }
    },
    "ProfileWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedVersion", "profiles"],
      "properties": {
        "expectedVersion": { "type": "integer", "minimum": 0 },
        "profiles": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/ReplyProfile" }
        }
      }
    },
    "InitializeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedVersion"],
      "properties": {
        "expectedVersion": { "const": 0 }
      }
    },
    "PublishRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedVersion"],
      "properties": {
        "expectedVersion": { "type": "integer", "minimum": 0 }
      }
    },
    "PreviewRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedVersion", "use", "channel", "messageType", "userMessage", "videoTitle", "userName"],
      "properties": {
        "expectedVersion": { "type": "integer", "minimum": 0 },
        "use": { "enum": ["draft", "published"] },
        "channel": { "$ref": "common.schema.json#/$defs/Channel" },
        "messageType": { "$ref": "common.schema.json#/$defs/MessageType" },
        "userMessage": { "$ref": "common.schema.json#/$defs/NullableString" },
        "videoTitle": { "$ref": "common.schema.json#/$defs/NullableString" },
        "userName": { "$ref": "common.schema.json#/$defs/NullableString" }
      }
    }
  }
}
