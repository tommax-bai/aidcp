+  assert.ok(cancelOutcome !== null && (cancelOutcome as Awaited<ReturnType<TaskEntryService['cancelTask']>>).accepted);
+  // 当前步执行完（终态 succeeded），后续步不再派发。
+  const steps = await h.runState.listStepRunsByRun(TARGET, created.runId);
