+test('aggregateRunOutcome：全成/全跳/混合/空集的诚实口径', () => {
+  assert.deepEqual(aggregateRunOutcome([{ outcome: 'succeeded', reasonCode: null }]),
+    { outcome: 'succeeded', reasonCode: null });
+  assert.deepEqual(
+    aggregateRunOutcome([
+      { outcome: 'skipped', reasonCode: 'no_qualified_target' },
