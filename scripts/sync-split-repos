    # AccountPersona / editor template 在 API 进程启动时读取；它不是 TS module，不能让
    # module-ownership 清单把它误报成「多出」后再靠人工复制维持运行。
    'aidcp-api': ['src/soul/soul.yaml'],
    'aidcp-content': ['assets'],
}

# 迁移覆盖对账所需：把 `aidcp-cloud/migrations` 按属主推导成「每个仓应有哪些迁移」，与实际目录比对。
# **只报不改**（与组装根同待遇）：搬迁移是有后果的操作，且「多出来的」可能是那个仓自己加的，
# 自动删/自动拷都可能踩坏一个库的账本。这里只负责让偏差**可见**。
MIGRATIONS_DIR = 'migrations'


def git(ref_repo: str, *args: str) -> str:
    return subprocess.run(
        ['git', '-C', ref_repo, *args], capture_output=True, text=True, check=True
    ).stdout


def git_bytes(ref_repo: str, *args: str) -> bytes:
    """二进制安全的 `git` —— 资产里有 .ttf，按文本读会被解码坏掉且不报错。"""
    return subprocess.run(['git', '-C', ref_repo, *args], capture_output=True, check=True).stdout


def sync_assets(args, repo: str, path: str) -> int:
    """镜像 REPO_ASSETS 声明的资产路径。返回差异数（0 = 已一致）。"""
    paths = REPO_ASSETS.get(repo)
    if not paths:
        return 0
    listing = git(CLOUD, 'ls-tree', '-r', '--name-only', args.ref, '--', *paths).split()
    add, changed = [], []
    for rel in sorted(listing):
        want = git_bytes(CLOUD, 'show', f'{args.ref}:{rel}')
        dst = os.path.join(path, rel)
        if not os.path.exists(dst):
            add.append(rel)
        else:
            with open(dst, 'rb') as fh:
                if fh.read() != want:
                    changed.append(rel)
        if args.apply and (not os.path.exists(dst) or rel in changed):
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            with open(dst, 'wb') as fh:
                fh.write(want)
    if add or changed:
        print(f'  资产（{"/".join(paths)}）：新增 {len(add)} · 内容不同 {len(changed)}')
        for rel in (add + changed)[:10]:
            print(f'   ⊕ {rel}')
    return len(add) + len(changed)


def migration_owner_scopes(ref: str) -> dict[str, set[str]]:
    """每个属主该有哪些迁移 —— **调用共享包的权威实现算，绝不在这里复刻规则。**

    本函数最初写成了一份 Python 复刻（按 `-- aidcp:objects=` 头自己解析、自己判属主），
    结果与权威实现**当场差了 1 条**：`index:` / `constraint:` 声明在 PG 里不带表名，
    权威实现因此**有意**让「只声明了索引的迁移」落进残留分支（计入全部属主，MUST NOT 猜），
    而复刻版把索引名当成了表名去查属主、查不到就丢掉 —— 于是那条迁移从某个属主的范围里静默消失。

    这正是本脚本 TRANSPORT_MEMBERS 注释里写的那句话，只不过是在本脚本自己身上应验的：
    「同一条迁移在不同仓算不同属主，而两侧都编译通过、测试都过，只有真跑迁移才炸。」
    所以这里跑 `tsx` 直接 import `aidcp-cloud/src/schema/`，一份规则、一个结果。
    """
    # 入口必须落在 CLOUD 里（body 用相对路径 import `./src/schema/`），但**路径必须唯一**：
    # 原先写死成 `.sync-migration-scopes.mts` 并在 finally 无条件删除，两个进程并跑时
    # 一方的清理会删掉另一方的入口 —— 表现为随机的 ERR_MODULE_NOT_FOUND + 迁移对账被跳过，
    # 而「跳过」只打一行警告、退出码不变，看着像对账过了。
    fd, script = tempfile.mkstemp(dir=CLOUD, prefix='.sync-migration-scopes-', suffix='.mts')
    os.close(fd)
    body = """
import { loadMigrationFiles } from './src/schema/migration-files.js';
import { loadMigrationOwnerScopes } from './src/schema/migration-owners.js';
import { buildOwnerScopes } from './src/schema/schema-gate.js';
import { narrowSchemaContract, REQUIRED_SCHEMA_VERSION } from './src/schema/schema-contract.js';
const files = await loadMigrationFiles(process.argv[2]);
const nameOf = new Map(files.map((f) => [f.name.replace(/\\.sql$/, ''), f.name]));
const { index } = await loadMigrationOwnerScopes(() => Promise.resolve(files));
const scopes = buildOwnerScopes(index);
const out = { _residue: index.residue, _narrowed: {} };
for (const owner of ['api', 'automation', 'content']) {
  out[owner] = scopes[owner].known.map((v) => nameOf.get(v) ?? `${v}.sql`);
  // 派生仓的启动契约 = 把单体那个「三家并集」的下限收窄到该属主自己的版本集上。
  // 这正是 narrowSchemaContract 存在的理由（它的注释点名了 content 库会被假 behind/ahead 判定），
  // 所以这里调它，不在 Python 侧复刻 —— 复刻过一次，当场差了 1 条。
  // 两个值 MUST 一起收窄。只窄 required 会让 knownMax 停在三家并集的最大版本，
  // 而派生仓的 migrations/ 里根本没有那一条 —— 「已知最高版本 ≠ 目录里的最高版本」当场破。
  out._narrowed[owner] = narrowSchemaContract(scopes[owner].known, REQUIRED_SCHEMA_VERSION);
}
console.log(JSON.stringify(out));
"""
    with open(script, 'w', encoding='utf8') as fh:
        fh.write(body)
    try:
        raw = subprocess.run(
            ['npx', 'tsx', script, os.path.join(CLOUD, MIGRATIONS_DIR)],
            cwd=CLOUD, capture_output=True, text=True, check=True,
        ).stdout.strip().splitlines()[-1]
    except subprocess.CalledProcessError as err:
        print(f'  ⚠ 迁移覆盖对账跳过（权威实现跑不起来）：{(err.stderr or "").strip()[:200]}')
        return {}
    finally:
        os.path.exists(script) and os.remove(script)
    # `_narrowed` 是 owner → 版本串的字典，其余是文件名列表；只把列表转成集合。
    return {k: (set(v) if isinstance(v, list) else v) for k, v in json.loads(raw).items()}


def check_migrations(path: str, scopes: dict[str, set[str]], layer: str) -> int:
    """对账某个仓的 migrations/ 是否等于它按属主该有的那一组。只报不改。"""
    want = scopes.get(layer)
    if want is None:
        return 0
    mig_path = os.path.join(path, MIGRATIONS_DIR)
    have = ({n for n in os.listdir(mig_path) if n.endswith('.sql')}
            if os.path.isdir(mig_path) else set())
    missing, extra = sorted(want - have), sorted(have - want)
    if not missing and not extra:
        print(f'  · 迁移覆盖对齐（{len(have)} 条）')
        return 0
    print(f'  ⚠ 迁移覆盖：应有 {len(want)} 实有 {len(have)} · 缺 {len(missing)} · 多 {len(extra)}（只报不改）')
    for n in missing[:10]:
        print(f'   ✗ 缺 {n} —— 该仓的库会永远缺这张表，而契约门只看最高版本、未必报')
    for n in extra[:10]:
        print(f'   ? 多 {n}（可能是该仓自己加的，不自动删）')
    return 1


def load_manifest(ref: str) -> dict[str, str]:
    raw = git(CLOUD, 'show', f'{ref}:{MANIFEST}')
    return {e['path']: e['layer'] for e in json.loads(raw)}


def rewrite_kernel_imports(text: str, kernel_paths: set[str], src_file: str) -> str:
    """把解析到 kernel 层文件的**相对** import 改写成 `aidcp-kernel/<src 相对路径>`。

    这正是手工切仓时用过的规则（已与 aidcp-api 现有产物逐行比对确认）：
        `./kernel/account-identity.js`   → `aidcp-kernel/kernel/account-identity.js`
        `./deployment-target.js`         → `aidcp-kernel/deployment-target.js`
    非 kernel 的相对 import 一律不动 —— 跨属主的那些正是要留着让编译器报出来的断裂。
    """

    def repl(m: re.Match[str]) -> str:
        quote, spec = m.group('q'), m.group('spec')
        if not spec.startswith('.'):
            return m.group(0)
        target = os.path.normpath(os.path.join(os.path.dirname(src_file), spec))
        as_ts = target[: -len('.js')] + '.ts' if target.endswith('.js') else target
        if as_ts not in kernel_paths:
            return m.group(0)
        rel = as_ts[len('src/'):]
        rel = rel[: -len('.ts')] + '.js'
        return f'{m.group("kw")}{quote}aidcp-kernel/{rel}{quote}'

    return re.sub(
        r'(?P<kw>\bfrom\s+|\bimport\s+)(?P<q>[\'"])(?P<spec>[^\'"]+)(?P=q)', repl, text
    )


def rewrite_shared_imports(text: str, kernel_paths: set[str], src_file: str) -> str:
    """kernel + transport 两个共享包的相对 import 一起改写成包说明符。

    只给 `scripts/` 用。`src/` 那边**不用**这条：三个业务仓的 src 各自持有自己属主层的
    文件，跨属主的相对 import 正是要留着让编译器报出来的断裂（见 rewrite_kernel_imports）。
    而 `scripts/migrate.ts` 三家一模一样、且要用的东西全在两个共享包里，没有「留着报错」的余地。

        `../src/kernel/pg-owner-connection-resolver.js` → `aidcp-kernel/kernel/pg-owner-connection-resolver.js`
        `../src/schema/migration-files.js`              → `aidcp-transport/schema/migration-files.js`

    **automation 也走包说明符**，尽管它本地有一份 `src/schema/`：三仓产出同一份文件，
    差异化改写等于给同一个脚本留两种形态，而两种形态的漂移没有任何工具会报。
    """
    transport_paths = set(TRANSPORT_MEMBERS)

    def repl(m: re.Match[str]) -> str:
        quote, spec = m.group('q'), m.group('spec')
        if not spec.startswith('.'):
            return m.group(0)
        target = os.path.normpath(os.path.join(os.path.dirname(src_file), spec))
        as_ts = target[: -len('.js')] + '.ts' if target.endswith('.js') else target
        if as_ts in kernel_paths:
            pkg = 'aidcp-kernel'
        elif as_ts in transport_paths:
            pkg = 'aidcp-transport'
        else:
            return m.group(0)
        rel = as_ts[len('src/'):][: -len('.ts')] + '.js'
        return f'{m.group("kw")}{quote}{pkg}/{rel}{quote}'

    return re.sub(
        r'(?P<kw>\bfrom\s+|\bimport\s+)(?P<q>[\'"])(?P<spec>[^\'"]+)(?P=q)', repl, text
    )


SCHEMA_VERSION_RE = re.compile(r"export const REQUIRED_SCHEMA_VERSION = '(?P<v>[^']+)';")
SCHEMA_KNOWN_MAX_RE = re.compile(r"export const KNOWN_MAX_SCHEMA_VERSION = '(?P<v>[^']+)';")


def derived_schema_version(scopes: dict, layer: str) -> str:
    """派生仓的启动契约版本 —— 取自云端 `narrowSchemaContract` 的收窄结果，**不在这里算**。

    单体的 `REQUIRED_SCHEMA_VERSION` 是三家并集上的下限；派生仓照抄，就会在启动自检里
    断言一条它根本不发的迁移。注意它**不等于「最高迁移」**（今天是 `0097`，而 `0098` 已存在）
    —— 它是手工设的下限，所以「取该仓最高属主迁移」是另一条规则、会在别的日子给出不同答案。

    **MUST NOT 把某个版本串写死。** 这里曾经写死过：改写规则拿当时云端的
    `0076_config_mirror_bump_inbox` 当「必须存在的源标记」，云端走到 `0097` 后当场
    RuntimeError —— 而且崩在字母序第二个仓（automation），**后面 content / kernel /
    transport 三个目标一个都没对账**，默认跑法看着却像跑完了。锚点选错的代价不是这一行
    改写失效，是整轮对账静默缩水到 1/5。
    """
    narrowed = (scopes.get('_narrowed') or {}).get(layer) or {}
    required, known_max = narrowed.get('required'), narrowed.get('knownMax')
    if not required or not known_max:
        raise RuntimeError(
            f'无法为 {layer} 取得收窄后的启动契约版本。'
            f'（权威实现跑不起来时上游返回 {{}}，此时 MUST 停手 —— '
            f'照抄单体版本会让派生仓断言一条它不发的迁移。先修 npx tsx 再来。）'
        )
    return required, known_max


def rewrite_schema_contract(text: str, scopes: dict, layer: str) -> str:
    """把启动契约的两个版本常量都收窄到该派生仓自己的属主范围（幂等、可复现）。

    **两个 MUST 一起改。** 只改下限、留着三家并集的「已知最高版本」，该仓的
    `migrations/` 里根本没有那一条 —— 「已知最高版本 ＝ 目录里的最高版本」这条不变量当场破，
    而它恰恰是「新增迁移后没抬版本号」的守卫。实测：只收窄 required 时 automation 从 6 红涨到 14 红。
    """
    required, known_max = derived_schema_version(scopes, layer)
    for pattern, name, value in (
        (SCHEMA_VERSION_RE, 'REQUIRED_SCHEMA_VERSION', required),
        (SCHEMA_KNOWN_MAX_RE, 'KNOWN_MAX_SCHEMA_VERSION', known_max),
    ):
        m = pattern.search(text)
        if not m:
            raise RuntimeError(
                f'schema-contract 里找不到 {name} 声明 —— 文件形状变了，'
                '先人工复核再改本脚本（这一条 MUST 响亮失败：静默跳过＝派生仓拿到单体版本）'
            )
        if m.group('v') == value:
            continue
        derived = (
            f'// Derived {layer} checkout: this repo only ships {layer}-owned migrations, so the\n'
            f'// start-up contract is narrowed to its own scope. Machine-derived on every sync by\n'
            f'// scripts/sync-split-repos:derived_schema_version — do not hand-edit.\n'
            f"export const {name} = '{value}';"
        )
        text = text[: m.start()] + derived + text[m.end():]
    return text


def rewrite_repo_source(
    repo: str,
    text: str,
    kernel_paths: set[str],
    src_file: str,
    scopes: dict[str, set[str]] | None = None,
) -> str:
    """Apply the reproducible, reviewed source adaptations for one derived repo."""
    text = rewrite_kernel_imports(text, kernel_paths, src_file)
    if repo == 'aidcp-automation' and src_file == 'src/schema/schema-contract.ts':
        text = rewrite_schema_contract(text, scopes or {}, 'automation')
    return text


def check_package_pin(repo_path: str, pkg_name: str, head: str, apply: bool) -> tuple[bool, str]:
    """消费仓 package.json 里对某个共享包的 pin，必须恒等于那个包 master 的头。

    返回 (是否有漂移, 说明)。这条不属于 src/ 对账，但同属「派生事实」：共享包一改，
    消费仓的 pin 同时过期，而 npm 不会报错 —— 它会老老实实装那个旧 sha，
    于是消费仓编译通过、跑的却是过期契约。**静默用旧契约正是这里的失败形态。**

    两个包都要查：kernel 是零副作用契约，transport 里还有跨进程路由名 —— 后者过期的后果更直接，
    两端路径对不上时**两边各自编译通过、各自测试通过，只有真跑起来才 404**。

    钉子写法（invert-split-fact-source §2 起）：规范形是 `git+ssh://…#v<semver>`（tag），
    历史裸 sha 与 `github:` 简写仍认识；tag 经本机兄弟 checkout 解析成 sha 后再与 head 比对。
    翻转前强度不变：解析出的 sha 必须等于共享包 master 头。翻转后的放宽口径见 report_flipped_pins。
    """
    pkg = os.path.join(repo_path, 'package.json')
    if not os.path.isfile(pkg):
        return False, 'package.json 不存在'
    with open(pkg, encoding='utf8') as fh:
        text = fh.read()
    repo = os.path.basename(repo_path.rstrip('/'))
    state, spec, extra = parse_shared_pin(text, pkg_name)
    if state == 'bad':
        return True, (
            f' ERROR: {repo}/package.json:{extra} 对 {pkg_name} 的写法不认识：{spec!r}'
            f'（只认 git+ssh://git@github.com/…#<ref> 与 github:owner/repo#<ref>；'
            f'真不依赖它的仓是**不写这一行**，不是换个写法）'
        )
    if state == 'absent':
        return False, f' 未 pin {pkg_name}（用得上它的仓才需要）'
    ref = extra
    pkg_repo = SHARED_PACKAGES[pkg_name]
    resolved = resolve_shared_ref(pkg_repo, ref)
    if resolved is None:
        return True, (
            f' ERROR: {repo} 的 {pkg_name} pin 引用 {ref} 在本机 {pkg_repo} checkout 里解析不了'
            f'（先 git -C {os.path.join(CODES, pkg_repo)} fetch --tags？）'
        )
    is_sha_ref = bool(re.fullmatch(r'[0-9a-f]{7,40}', ref))
    shown = ref if not is_sha_ref else ref[:7]
    if resolved == head:
        return False, f' {pkg_name} pin 对齐（{shown} → {resolved[:7]}）'
    if is_sha_ref:
        # 裸 sha 钉子仍保留 --apply 自动追头（只换 # 后的 ref，不动写法）。
        if apply:
            new_spec = spec[: spec.rfind('#') + 1] + head
            with open(pkg, 'w', encoding='utf8') as fh:
                fh.write(text.replace(f'"{spec}"', f'"{new_spec}"', 1))
            return True, f' {pkg_name} pin {shown} → {head[:7]}（已更新，记得 npm install 刷 lock）'
        return True, f' {pkg_name} pin 过期：{shown} ≠ {pkg_name} master {head[:7]}'
    # tag 钉子过期＝head 已越过这个 tag。正确动作是在共享包仓打新 tag 再 bump 钉子；
    # **绝不自动把 tag 改写回裸 sha**（那会悄悄退掉版本化写法），--apply 对它也只报不改。
    return True, (
        f' {pkg_name} pin {shown}（→ {resolved[:7]}）落后 master {head[:7]}：'
        f'head 已越过该 tag，需在 {pkg_repo} 打新 tag 并 bump 钉子（tag 钉子不自动改写）'
    )


def report_flipped_pins() -> int:
    """翻转后的 pin 报告（invert-split-fact-source §2.3③）。返回退出码。

    翻转后共享包按 tag 发版，消费仓不再被要求追 master 头：
    - 钉子必须**落在某个已存在的 tag 上**（tag 引用，或恰好指向某 tag 目标 commit 的 sha）——
      不落在任何 tag 上的钉子指向「未发版」的中间提交，仍是错误；
    - 落后最新 tag **只报告不判错**（仓名、所钉 tag、最新 tag），升级节奏归各仓自己。
    写法不认识 / 引用解析不了，与翻转前同样响亮报错。
    """
    code = 0
    consumers = [r for r in REPOS if r != KERNEL_REPO] + [TRANSPORT_REPO]
    print('共享包 pin（翻转后口径：必须钉在 tag 上；落后最新 tag 只报告）：')
    for repo in consumers:
        path = os.path.join(CODES, repo)
        pkg_json = os.path.join(path, 'package.json')
        if not os.path.isfile(pkg_json):
            continue
        with open(pkg_json, encoding='utf8') as fh:
            text = fh.read()
        for pkg_name, pkg_repo in SHARED_PACKAGES.items():
            if repo == pkg_repo:
                continue  # transport 不 pin 自己
            state, spec, extra = parse_shared_pin(text, pkg_name)
            if state == 'absent':
                continue
            if state == 'bad':
                print(f'  ERROR: {repo}/package.json:{extra} 对 {pkg_name} 的写法不认识：{spec!r}'
                      f'（只认 git+ssh://…#<ref> 与 github:owner/repo#<ref>）')
                code = 1
                continue
            ref = extra
            resolved = resolve_shared_ref(pkg_repo, ref)
            if resolved is None:
                print(f'  ERROR: {repo} 的 {pkg_name} pin 引用 {ref} 在本机 {pkg_repo} checkout 里解析不了'
                      f'（先 git -C {os.path.join(CODES, pkg_repo)} fetch --tags？）')
                code = 1
                continue
            tags_at = [t for t in git(os.path.join(CODES, pkg_repo), 'tag', '--points-at', resolved)
                       .split('\n') if t]
            if not tags_at:
                print(f'  ERROR: {repo} 的 {pkg_name} pin {ref}（→ {resolved[:7]}）不落在任何 tag 上：'
                      f'翻转后共享包按 tag 发版，先在 {pkg_repo} 打 tag 再钉')
                code = 1
                continue
            pinned = ref if ref in tags_at else tags_at[0]
            newest = latest_tag(pkg_repo)
            if newest and newest not in tags_at:
                print(f'  {repo}: {pkg_name} pin {pinned} 落后最新 tag {newest}（只报告，不判错）')
            else:
                print(f'  {repo}: {pkg_name} pin {pinned} = 最新 tag')
    return code


# ── 测试的归属：**派生的，不是人分配的** ────────────────────────────────────────────────
# 判据＝这个测试 import 了哪些属主的 src。单属主 → 归那个仓；跨属主 → 留在 aidcp-cloud。
# 这条规则会**自己变好**：每消掉一条跨服务耦合，就有一批测试从「跨属主」变成「单属主」、
# 自动变得可派生。不需要有人维护一张测试清单。
IMPORT_RE = re.compile(r"""(?:from\s+|import\s*\(\s*)['"]([^'"]+)['"]""")
FIXTURE_DIR_RE = re.compile(
    r"""new\s+URL\(\s*['"]([^'"]+/)['"]\s*,\s*import\.meta\.url\s*\)"""
)
BIZ_LAYERS = ('api', 'automation', 'content')

# 归属的第二类判据：**测试还会按路径直接读仓里的文件**，而路径读没有 import 边可推。
# 实测三种形态，只按 import 判归属时全部会被派到读不到目标文件的仓里：
#   ① `new URL('../../migrations/0094_x.sql', import.meta.url)` —— 读的是**别属主**的迁移；
#   ② `` new URL(`../../migrations/${name}`, ...) `` —— 字面前缀只到目录，实际读整个 migrations/；
#   ③ `` new URL(`../../${rel}`, ...) `` / 读 `src/server.ts` —— 全仓扫描或读**组装根**。
# 后果不是「同步搬坏了」而是「归属本身判错」：搬过去必红，且红在文件缺失上、看着像同步的锅。
# 判据与 import 完全一致 —— 触到的属主超过一个就留守 cloud，不强行分配。
PATH_LITERAL_RE = re.compile(r"""['"`](\.{1,2}/[^'"`\n$]*)""")
# 组装根按设计**从不同步**（各仓自己写 main()），所以任何按路径读它的测试在派生仓里
# 永远读不到对应内容 —— 这类测试不是「暂时跨属主」，是**结构上不可派生**，一律留守。
COMPOSITION_ROOT_FILES = ('src/server.ts', 'src/index.ts')


def _resolve(spec: str, from_file: str) -> str:
    p = os.path.normpath(os.path.join(os.path.dirname(from_file), spec))
    return p[: -len('.js')] + '.ts' if p.endswith('.js') else p


def file_presence(
    path: str, own: dict[str, str], mig_scopes: dict[str, set[str]]
) -> set[str] | None:
    """这个文件最终会出现在哪些属主的仓里。None = 不构成约束（仓外文件 / 每个仓各有一份）。"""
    layer = own.get(path)
    if layer:
        return {layer}
    if path.startswith(MIGRATIONS_DIR + '/'):
        name = os.path.basename(path)
        return {o for o in BIZ_LAYERS if name in mig_scopes.get(o, ())}
    return None


def path_read_candidates(
    text: str,
    from_file: str,
    tracked: list[str],
    own: dict[str, str],
    mig_scopes: dict[str, set[str]],
    import_specs: set[str],
) -> tuple[set[str] | None, bool]:
    """字面路径读 → (还剩哪些属主读得到全部被读文件, 是否读了组装根)。

    **与 import 是两种语义，不能混算**：import 说的是「需要谁的代码」（并集必须收敛到一个属主），
    路径读说的是「需要哪些文件在场」（能容纳它的属主取交集）。早先把两者混成一个并集，
    于是一条只读 automation 自己两条迁移的测试，会因为其中一条迁移**同时**属于 api
    而被判成跨属主 —— 白白丢掉一批本来派得下去的测试。

    字面串可能只是**前缀**（模板拼接到 `${` 为止），此时按目录处理：测试可能读到该目录下任意一个，
    所以要求属主同时具备全部。`../../` 即仓根，于是「全仓扫描」自然收敛到空集、如实留守。
    """
    candidates: set[str] | None = None
    for m in PATH_LITERAL_RE.finditer(text):
        spec = m.group(1)
        if spec in import_specs:
            continue  # import 说明符另有判据，别在这里重复推导
        target = os.path.normpath(os.path.join(os.path.dirname(from_file), spec))
        if target == '.':
            target = ''
        if target.startswith('test/'):
            continue  # 测试自带的 helper / fixture 由 test_local_deps 负责
        if target in tracked:
            if target in COMPOSITION_ROOT_FILES:
                return None, True
            hits = [target]
        else:
            prefix = (target + '/') if target else ''
            hits = [p for p in tracked if p.startswith(prefix)]
        for path in hits:
            present = (
                set() if path in COMPOSITION_ROOT_FILES
                else file_presence(path, own, mig_scopes)
            )
            if present is None:
                continue
            candidates = present if candidates is None else (candidates & present)
    return candidates, False


def classify_tests(
    own: dict[str, str], ref: str, mig_scopes: dict[str, set[str]]
) -> tuple[dict[str, str], dict[str, list[str]], int, int]:
    """返回 (测试路径 → 归属仓 or ''，归属仓 → 测试清单，读组装根条数，路径读不落地条数)。

    '' = 跨属主或不可派生，留守 aidcp-cloud。
    """
    listing = git(CLOUD, 'ls-tree', '-r', '--name-only', ref).split()
    tracked = set(listing)
    tracked_list = sorted(tracked)
    tests = [f for f in listing if f.startswith('test/') and f.endswith('.ts')]
    verdict: dict[str, str] = {}
    by_repo: dict[str, list[str]] = {}
    root_readers = 0
    unreachable_reads = 0
    for t in tests:
        entry_text = git(CLOUD, 'show', f'{ref}:{t}')
        if 'aidcp:test-owner=cloud' in entry_text:
            verdict[t] = ''
            continue
        layers = set()
        candidates: set[str] | None = None
        reads_root = False
        # Test helpers can import owner source that the entry itself never
        # mentions. Classify the complete local-test dependency closure so a
        # helper cannot smuggle API/content modules into a derived repo.
        for dep in test_local_deps(ref, t, set(), tracked):
            if not dep.endswith('.ts'):
                continue
            text = git(CLOUD, 'show', f'{ref}:{dep}')
            specs = set()
            for m in IMPORT_RE.finditer(text):
                spec = m.group(1)
                specs.add(spec)
                if not spec.startswith('.'):
                    continue
                layer = own.get(_resolve(spec, dep))
                if layer:
                    layers.add(layer)
            reachable, hit_root = path_read_candidates(
                text, dep, tracked_list, own, mig_scopes, specs
            )
            if hit_root:
                reads_root = True
                break
            if reachable is not None:
                candidates = reachable if candidates is None else (candidates & reachable)
        if reads_root:
            verdict[t] = ''
            root_readers += 1
            continue
        biz = layers & set(BIZ_LAYERS)
        if len(biz) == 1:
            only = next(iter(biz))
            repo = next(r for r, l in REPOS.items() if l == only)
        elif not biz and 'kernel' in layers:
            only, repo = 'kernel', KERNEL_REPO
        else:
            verdict[t] = ''  # 跨属主或与 src 无关：留守
            continue
        # import 定了「该去哪个仓」，路径读定了「那个仓读不读得到它要的文件」。
        # 后者不满足时搬过去必红，且红在文件缺失上 —— 看着像同步搬坏了，其实是归属判错。
        if candidates is not None and only not in candidates:
            verdict[t] = ''
            unreachable_reads += 1
            continue
        verdict[t] = repo
        by_repo.setdefault(repo, []).append(t)
    return verdict, by_repo, root_readers, unreachable_reads


def test_local_deps(ref: str, entry: str, seen: set[str], tracked: set[str]) -> set[str]:
    """测试自带的 helper / fixture（`test/` 内的相对依赖）必须跟着一起搬，否则搬过去也跑不起来。"""
    if entry in seen:
        return seen
    seen.add(entry)
    try:
        text = git(CLOUD, 'show', f'{ref}:{entry}')
    except subprocess.CalledProcessError:
        return seen
    for m in IMPORT_RE.finditer(text):
        spec = m.group(1)
        if not spec.startswith('.'):
            continue
        dep = _resolve(spec, entry)
        if dep.startswith('test/'):
            test_local_deps(ref, dep, seen, tracked)
    # Some frozen contracts are loaded by filename at runtime, so no static
    # import can enumerate them. A literal fixture directory is still a closed,
    # reviewable dependency: include every tracked file beneath that directory.
    for match in FIXTURE_DIR_RE.finditer(text):
        prefix = os.path.normpath(
            os.path.join(os.path.dirname(entry), match.group(1))
        ).rstrip('/') + '/'
        if prefix.startswith('test/fixtures/'):
            seen.update(path for path in tracked if path.startswith(prefix))
    return seen


def main() -> int:
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument('--ref', default='origin/master', help='aidcp-cloud 的源 ref（默认 origin/master）')
    ap.add_argument('--apply', action='store_true', help='写入差异（组装根除外）')
    ap.add_argument('--prune', action='store_true', help='连同删除清单外的 src 文件（需 --apply）')
    ap.add_argument('--repo', action='append', help='只处理指定仓，可重复')
    ap.add_argument('--tests', action='store_true', help='同时对账 / 同步 test/（归属由 import 派生）')
    args = ap.parse_args()

    if args.prune and not args.apply:
        print('ERROR: --prune 需与 --apply 同用', file=sys.stderr)
        return 2
    if args.prune and args.tests:
        print(
            'ERROR: --prune 只允许处理 src/；不得与 --tests 同用，派生私有测试必须显式保留',
            file=sys.stderr,
        )
        return 2
    if not os.path.isdir(CLOUD):
        print(f'ERROR: 找不到 aidcp-cloud：{CLOUD}', file=sys.stderr)
        return 2

    try:
        subprocess.run(['git', '-C', CLOUD, 'rev-parse', '--verify', args.ref],
                       capture_output=True, check=True)
    except subprocess.CalledProcessError:
        print(f'ERROR: aidcp-cloud 里没有 ref {args.ref}（先 git fetch？）', file=sys.stderr)
        return 2

    fact = load_fact_source()
    if fact.get('flipped'):
        if args.apply or args.prune:
            print(
                'ERROR: 事实源已翻转（scripts/fact-source.json）：派生仓已是各自代码的唯一事实源，\n'
                '重放写入（--apply / --prune）已退役。改动请直接落对应派生仓；\n'
                '详见 openspec change invert-split-fact-source。',
                file=sys.stderr,
            )
            return 2
        frozen = fact.get('frozenCloudRef')
        if not frozen:
            print('ERROR: fact-source.json 已置 flipped=true 但缺 frozenCloudRef', file=sys.stderr)
            return 2
        try:
            subprocess.run(['git', '-C', CLOUD, 'rev-parse', '--verify', '--quiet', f'{frozen}^{{commit}}'],
                           capture_output=True, check=True)
        except subprocess.CalledProcessError:
            print(f'ERROR: frozenCloudRef {frozen} 在 aidcp-cloud 里不存在（先 git fetch？）', file=sys.stderr)
            return 2
        # 冻结校验：受冻结目录要么**整目录已删除**（cutover 5.4 的完成态），要么逐字等于冻结 ref。
        # 「存在但有差异」才是违规——那只可能来自「有人还按旧模式改 cloud」。
        problems: list[str] = []
        states: list[str] = []
        for frozen_dir in ('src', MIGRATIONS_DIR):
            present = git(CLOUD, 'ls-tree', '--name-only', args.ref, '--', frozen_dir).strip()
            if not present:
                states.append(f'{frozen_dir}/ 已删除（cutover 完成态）')
                continue
            changed = [f for f in git(CLOUD, 'diff', '--name-only', frozen, args.ref,
                                      '--', frozen_dir + '/').split('\n') if f]
            if changed:
                problems.extend(changed)
            else:
                states.append(f'{frozen_dir}/ 与冻结 ref 逐字一致')
        if problems:
            print(f'ERROR: aidcp-cloud 已冻结于 {frozen[:12]}，但 {args.ref} 上有 {len(problems)} 个受冻结文件的改动：',
                  file=sys.stderr)
            for f in problems[:50]:
                print(f'  {f}', file=sys.stderr)
            print('  事实源已翻转：这些改动必须落到对应派生仓，cloud 侧须回退（整目录删除＝完成态，不在此列）。',
                  file=sys.stderr)
            return 1
        print(f'事实源已翻转：aidcp-cloud 冻结于 {frozen[:12]}；' + '；'.join(states) + '。冻结校验通过。')
        return report_flipped_pins()

    sha = git(CLOUD, 'rev-parse', '--short', args.ref).strip()
    own = load_manifest(args.ref)
    kernel_paths = {p for p, layer in own.items() if layer == 'kernel'}
    mig_scopes = migration_owner_scopes(args.ref)
    print(f'源: aidcp-cloud@{sha}（{args.ref}）  清单 {len(own)} 个 src 文件')
    residue = mig_scopes.get('_residue', set())
    if residue:
        print(f'迁移残留 {len(residue)} 条（头声明为空 ⇒ 按安全方向计入全部属主）')
    print(f'模式: {"APPLY" + ("+PRUNE" if args.prune else "") if args.apply else "CHECK（只读）"}\n')

    # 共享包的 master 头：消费仓的 pin 都得等于它（漂了是静默用旧契约，见 check_package_pin）。
    shared_heads: dict[str, str] = {}
    for pkg_name, repo_name in SHARED_PACKAGES.items():
        repo_dir = os.path.join(CODES, repo_name)
        if os.path.isdir(repo_dir):
            shared_heads[pkg_name] = git(repo_dir, 'rev-parse', 'HEAD').strip()
    if shared_heads:
        summary = '，'.join(f'{n} {h[:7]}' for n, h in shared_heads.items())
        print(f'共享包头: {summary}（消费仓 pin 应等于它）\n')

    requested = args.repo or [*REPOS, TRANSPORT_REPO]
    unknown = [repo for repo in requested if repo not in REPOS and repo != TRANSPORT_REPO]
    if unknown:
        print(f'ERROR: 未知仓 {unknown[0]}', file=sys.stderr)
        return 2
    targets = [repo for repo in requested if repo in REPOS]
    exit_code = 0
    for repo in targets:
        layer = REPOS.get(repo)
        if layer is None:
            print(f'ERROR: 未知仓 {repo}', file=sys.stderr)
            return 2
        path = os.path.join(CODES, repo)
        if not os.path.isdir(path):
            print(f'=== {repo} ===\n  SKIP: 本机未 clone（{path}）\n')
            continue

        expected = {p for p, l in own.items() if l == layer}
        if layer != 'kernel':
            expected |= COMPOSITION & set(own)  # 组装根三份副本，只报不改
        asset_paths = REPO_ASSETS.get(repo, [])
        runtime_assets = (
            set(git(CLOUD, 'ls-tree', '-r', '--name-only', args.ref, '--', *asset_paths).split())
            if asset_paths
            else set()
        )
        actual = {
            f for f in git(path, 'ls-files').split()
            if (
                f.startswith('src/')
                and f not in runtime_assets
                and f not in DERIVED_COMPOSITION.get(repo, set())
            )
        }

        add, remove = sorted(expected - actual), sorted(actual - expected)
        changed, comp_changed = [], []
        for rel in sorted(expected & actual):
            want = git(CLOUD, 'show', f'{args.ref}:{rel}')
            if layer != 'kernel':
                want = rewrite_repo_source(repo, want, kernel_paths, rel, mig_scopes)
            with open(os.path.join(path, rel), encoding='utf8') as fh:
                if fh.read() != want:
                    (comp_changed if rel in COMPOSITION else changed).append(rel)

        print(f'=== {repo}（属主 {layer}）实际 src {len(actual)} / 应有 {len(expected)} ===')
        print(f'  新增 {len(add)} · 内容不同 {len(changed)} · 多出 {len(remove)} · 组装根不同 {len(comp_changed)}')
        if layer != 'kernel':
            for pkg_name, head in shared_heads.items():
                drifted, note = check_package_pin(path, pkg_name, head, args.apply)
                print(f'  ·{note}')
                if drifted and not args.apply:
                    exit_code = 1
        for rel in add[:10]:
            print(f'   + {rel}')
        for rel in changed[:10]:
            print(f'   ~ {rel}')
        for rel in remove[:10]:
            print(f'   ! {rel}（清单里没有；--prune 才会删）')
        for rel in comp_changed:
            print(f'   ⊘ {rel}（组装根：只报不改，批次 2/3/4 各仓自己写 main()）')
        for rel in sorted(DERIVED_COMPOSITION.get(repo, set())):
            if os.path.isfile(os.path.join(path, rel)):
                print(f'   ⊙ {rel}（派生仓私有组装根：无 Cloud 对应物，只登记不覆盖）')
        asset_diff = sync_assets(args, repo, path)
        mig_diff = check_migrations(path, mig_scopes, layer)
        if add or changed or remove or comp_changed or asset_diff or mig_diff:
            exit_code = 1

        if args.apply:
            wrote = 0
            for rel in add + changed:
                if rel in COMPOSITION:
                    continue
                want = git(CLOUD, 'show', f'{args.ref}:{rel}')
                if layer != 'kernel':
                    want = rewrite_repo_source(repo, want, kernel_paths, rel, mig_scopes)
                dst = os.path.join(path, rel)
                os.makedirs(os.path.dirname(dst), exist_ok=True)
                with open(dst, 'w', encoding='utf8') as fh:
                    fh.write(want)
                wrote += 1
            pruned = 0
            if args.prune:
                for rel in remove:
                    # 「多出」是**对着工作区扫出来的**，但删除是幂等的目标态：文件已不在就算达成。
                    # 上一轮 --prune 删过、这一轮工作区仍未提交时会再次列出同一条，此时 os.remove 抛
                    # FileNotFoundError 直接中断整轮——后面几个仓一个都同步不到，且看着像同步跑完了。
                    # 判据是「文件是否还在」，不是「这一次是不是我删的」。
                    try:
                        os.remove(os.path.join(path, rel))
                        pruned += 1
                    except FileNotFoundError:
                        pass
            print(f'  → 写入 {wrote} 个文件' + (f'，删除 {pruned} 个' if args.prune else ''))
            print('  → 变更留在工作区未提交：请自行 review + commit（本脚本绝不代你提交）')
        print()

    if (not args.repo) or TRANSPORT_REPO in (args.repo or []):
        exit_code = sync_transport(args, own, kernel_paths, shared_heads) or exit_code

    selected_script_repos = set(REPOS) - {KERNEL_REPO} if not args.repo else (
        set(args.repo) & (set(REPOS) - {KERNEL_REPO})
    )
    if selected_script_repos:
        exit_code = sync_scripts(args, kernel_paths, selected_script_repos) or exit_code
        exit_code = sync_migration_aux(args, selected_script_repos) or exit_code

    if args.tests:
        selected_test_repos = set(REPOS) if not args.repo else set(args.repo) & set(REPOS)
        exit_code = sync_tests(
            args, own, kernel_paths, mig_scopes, selected_test_repos
        ) or exit_code

    if exit_code and not args.apply:
        print('存在差异。--apply 可同步（组装根除外）；组装根的差异须人工判断。')
    return 0 if args.apply else exit_code


def sync_migration_aux(args, selected_repos: set[str]) -> int:
    """`migrations/` 里**非 .sql 的判据文件**：逐文件点名、逐字节镜像，三仓一份。

    为什么不能靠 `check_migrations`：那道对账只比 `.sql` 文件集合，对目录里的 JSON 判据**完全无感**
    —— 缺了既不会被报「缺」、也不会被报「多」。而这份判据是三个派生仓迁移 CLI 与**启动契约门**
    的必读输入（执行范围解析顺序的第 ② 步），缺了它三个服务的契约门会判「判据不可用」而拒绝启动。
    「谁都不管、缺了也没人报」正是 scripts/ 那次的同一个根因，不能在隔壁目录再来一遍。

    与 `.sql` 的处置有意不同：迁移文件按属主分发（各仓只持自己那批），而这份名册是**全量判据**
    ——它要回答的是「任意一条迁移的执行范围是什么」，按属主裁剪等于让派生仓看不见另一家的条目，
    条目数一变，`sealedEntryCount` 的只减不增断言当场对不上。
    """
    exit_code = 0
    print(f'=== migrations/ 判据文件（逐文件点名 {len(MIGRATION_AUX_MEMBERS)} 个）===')
    for repo in sorted(selected_repos):
        path = os.path.join(CODES, repo)
        if not os.path.isdir(path):
            print(f'  {repo}: SKIP（本机未 clone）')
            continue
        add, changed = [], []
        for rel in MIGRATION_AUX_MEMBERS:
            want = git(CLOUD, 'show', f'{args.ref}:{rel}')
            dst = os.path.join(path, rel)
            if not os.path.exists(dst):
                add.append(rel)
            else:
                with open(dst, encoding='utf8') as fh:
                    if fh.read() != want:
                        changed.append(rel)
            if args.apply and (rel in add or rel in changed):
                os.makedirs(os.path.dirname(dst), exist_ok=True)
                with open(dst, 'w', encoding='utf8') as fh:
                    fh.write(want)
        print(f'  {repo}: 新增 {len(add)} · 内容不同 {len(changed)}')
        for rel in add + changed:
            print(f'   {"+" if rel in add else "~"} {rel}')
        if add or changed:
            exit_code = 1
    print()
    return 0 if args.apply else exit_code


def sync_scripts(args, kernel_paths, selected_repos: set[str]) -> int:
    """三个业务仓 `scripts/` 的对账 / 同步：逐文件点名（SCRIPT_MEMBERS），三仓产出同一份。

    与 src/ 段的两处**有意不同**：
      ① 改写用 rewrite_shared_imports（kernel + transport 一起），不是只改 kernel ——
         `scripts/migrate.ts` 要用的东西全在两个共享包里，留一条断裂就等于命令起不来；
      ② 三仓不做差异化：automation 本地虽有 src/schema/，也照样走包说明符（理由见改写器注释）。
    """
    exit_code = 0
    print(f'=== scripts/（逐文件点名 {len(SCRIPT_MEMBERS)} 个）===')
    for repo in sorted(selected_repos):
        path = os.path.join(CODES, repo)
        if not os.path.isdir(path):
            print(f'  {repo}: SKIP（本机未 clone）')
            continue
        tracked = {f for f in git(path, 'ls-files').split() if f.startswith('scripts/')}
        unmanaged = sorted(f for f in tracked if f.startswith(SCRIPT_UNMANAGED))
        actual = tracked - set(unmanaged)
        expected = set(SCRIPT_MEMBERS)
        add, remove, changed = sorted(expected - actual), sorted(actual - expected), []
        for rel in sorted(expected & actual):
            want = rewrite_shared_imports(git(CLOUD, 'show', f'{args.ref}:{rel}'), kernel_paths, rel)
            with open(os.path.join(path, rel), encoding='utf8') as fh:
                if fh.read() != want:
                    changed.append(rel)
        print(
            f'  {repo}: 新增 {len(add)} · 内容不同 {len(changed)} · 多出 {len(remove)}'
            f' · 有意不纳管 {len(unmanaged)}'
        )
        for rel in add + changed:
            print(f'   {"+" if rel in add else "~"} {rel}')
        for rel in remove:
            print(f'   ! {rel}（不在点名清单；--prune 才会删）')
        if add or changed or remove:
            exit_code = 1
        if args.apply:
            for rel in add + changed:
                want = rewrite_shared_imports(git(CLOUD, 'show', f'{args.ref}:{rel}'), kernel_paths, rel)
                dst = os.path.join(path, rel)
                os.makedirs(os.path.dirname(dst), exist_ok=True)
                with open(dst, 'w', encoding='utf8') as fh:
                    fh.write(want)
            pruned = 0
            if args.prune:
                for rel in remove:
                    # 同 src/ 段：判据是「文件是否还在」，不是「这一次是不是我删的」。
                    try:
                        os.remove(os.path.join(path, rel))
                        pruned += 1
                    except FileNotFoundError:
                        pass
            print(f'  → 写入 {len(add) + len(changed)} 个文件' + (f'，删除 {pruned} 个' if args.prune else ''))
    print()
    return exit_code


def sync_transport(args, own, kernel_paths, shared_heads) -> int:
    """共享传输层的对账：逐文件点名（不是按属主层切），其余纪律与三仓一致。"""
    path = os.path.join(CODES, TRANSPORT_REPO)
    if not os.path.isdir(path):
        print(f'=== {TRANSPORT_REPO} ===\n  SKIP: 本机未 clone（{path}）\n')
        return 0
    actual = {f for f in git(path, 'ls-files').split() if f.startswith('src/')}
    # 点名了、但源 ref 上还没有那个文件的成员：并行开发下这是常态——把成员名加进本清单的提交
    # （控制仓）先于对应文件落到 aidcp-cloud master。此前这里会让整条同步**当场崩掉**，
    # 连带别人那批已经就绪的文件一起同步不了。改成响亮跳过 + 退出码非 0：
    # 报出来是必须的（清单与事实源不一致本身就是要人处理的事），但 MUST NOT 因此株连整批。
    missing_at_ref = sorted(
        rel for rel in TRANSPORT_MEMBERS
        if subprocess.run(['git', '-C', CLOUD, 'cat-file', '-e', f'{args.ref}:{rel}'],
                          capture_output=True).returncode != 0
    )
    expected = set(TRANSPORT_MEMBERS) - set(missing_at_ref)
    add, remove, changed = sorted(expected - actual), sorted(actual - expected), []
    for rel in sorted(expected & actual):
        want = rewrite_kernel_imports(git(CLOUD, 'show', f'{args.ref}:{rel}'), kernel_paths, rel)
        with open(os.path.join(path, rel), encoding='utf8') as fh:
            if fh.read() != want:
                changed.append(rel)
    print(f'=== {TRANSPORT_REPO}（逐文件点名 {len(expected)} 个）实际 src {len(actual)} ===')
    print(f'  新增 {len(add)} · 内容不同 {len(changed)} · 多出 {len(remove)}')
    # transport 只 pin kernel —— 它**是** transport，不会 pin 自己。
    if 'aidcp-kernel' in shared_heads:
        drifted, note = check_package_pin(path, 'aidcp-kernel', shared_heads['aidcp-kernel'], args.apply)
        print(f'  ·{note}')
        if drifted and not args.apply:
            return 1
    for rel in add + changed:
        print(f'   {"+" if rel in add else "~"} {rel}')
    for rel in remove:
        print(f'   ! {rel}（不在点名清单；--prune 才会删）')
    for rel in missing_at_ref:
        print(f'   ⚠ {rel}（已点名但 {args.ref} 上还没有这个文件：本轮跳过，等它落到 cloud 再同步）')
    drift = bool(add or changed or remove or missing_at_ref)
    if args.apply:
        for rel in add + changed:
            want = rewrite_kernel_imports(git(CLOUD, 'show', f'{args.ref}:{rel}'), kernel_paths, rel)
            dst = os.path.join(path, rel)
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            with open(dst, 'w', encoding='utf8') as fh:
                fh.write(want)
        pruned = 0
        if args.prune:
            for rel in remove:
                os.remove(os.path.join(path, rel))
                pruned += 1
        print(f'  → 写入 {len(add) + len(changed)} 个文件' + (f'，删除 {pruned} 个' if args.prune else ''))
    print()
    return 1 if drift else 0


def sync_tests(args, own, kernel_paths, mig_scopes, selected_repos: set[str]) -> int:
    """按派生归属对账 / 同步 test/。跨属主的测试**留守 aidcp-cloud**，不强行分配。"""
    verdict, by_repo, root_readers, unreachable_reads = classify_tests(
        own, args.ref, mig_scopes
    )
    tracked = set(git(CLOUD, 'ls-tree', '-r', '--name-only', args.ref).split())
    stay = sum(1 for v in verdict.values() if not v)
    print(f'=== test/ 归属（由 import + 字面路径读派生，共 {len(verdict)} 个文件）===')
    for repo in sorted(by_repo):
        print(f'  {repo:20s} {len(by_repo[repo]):4d}')
    print(f'  {"（跨属主·留守 cloud）":20s} {stay:4d}  ← 每消掉一条跨服务耦合，这里就自动少几个')
    if root_readers:
        print(
            f'  {"其中读组装根·不可派生":20s} {root_readers:4d}'
            '  ← 组装根从不同步，这类测试在派生仓里永远读不到，属结构性留守'
        )
    if unreachable_reads:
        print(
            f'  {"其中路径读落在别属主":20s} {unreachable_reads:4d}'
            '  ← import 指向本仓、却按路径读别属主的文件，搬过去必红'
        )
    drift = 0
    for repo, entries in sorted(by_repo.items()):
        if repo not in selected_repos:
            continue
        path = os.path.join(CODES, repo)
        if not os.path.isdir(path):
            continue
        wanted: set[str] = set()
        for e in entries:
            wanted |= test_local_deps(args.ref, e, set(), tracked)
        # import 说明符不保证指向真实文件（模板拼接、条件路径等）；只搬 ref 里确实存在的。
        wanted &= tracked
        actual = {f for f in git(path, 'ls-files').split() if f.startswith('test/')}
        derived_private = {
            rel for rel in actual
            if os.path.isfile(os.path.join(path, rel))
            and 'aidcp:test-owner=derived' in open(
                os.path.join(path, rel), encoding='utf8'
            ).read()
        }
        actual = {rel for rel in actual if os.path.isfile(os.path.join(path, rel))}
        wanted -= derived_private
        synced_actual = actual - derived_private
        add, remove, changed = (
            sorted(wanted - synced_actual),
            sorted(synced_actual - wanted),
            [],
        )
        for rel in sorted(wanted & synced_actual):
            want = git(CLOUD, 'show', f'{args.ref}:{rel}')
            if repo != KERNEL_REPO:
                want = rewrite_kernel_imports(want, kernel_paths, rel)
            with open(os.path.join(path, rel), encoding='utf8') as fh:
                if fh.read() != want:
                    changed.append(rel)
        if add or remove or changed:
            drift = 1
        print(
            f'  {repo}: 新增 {len(add)} · 内容不同 {len(changed)} · 多出 {len(remove)}'
            f' · 派生私有 {len(derived_private)}'
        )
        # 「多出」在 test/ 这里几乎总是**归属判定变了**（某条测试被重判为跨属主 / 不可派生），
        # 而 --prune 对 test/ 是禁用的 —— 不点名就只剩一个数字，那个数字看不出该删哪一个。
        for rel in remove[:20]:
            print(f'   ? 多出 {rel}（归属已变，--tests 不自动删，请人工确认后删除）')
        if args.apply:
            for rel in add + changed:
                want = git(CLOUD, 'show', f'{args.ref}:{rel}')
                if repo != KERNEL_REPO:
                    want = rewrite_kernel_imports(want, kernel_paths, rel)
                dst = os.path.join(path, rel)
                os.makedirs(os.path.dirname(dst), exist_ok=True)
                with open(dst, 'w', encoding='utf8') as fh:
                    fh.write(want)
            pruned = 0
            if args.prune:
                for rel in remove:
                    # 「多出」是**对着工作区扫出来的**，但删除是幂等的目标态：文件已不在就算达成。
                    # 上一轮 --prune 删过、这一轮工作区仍未提交时会再次列出同一条，此时 os.remove 抛
                    # FileNotFoundError 直接中断整轮——后面几个仓一个都同步不到，且看着像同步跑完了。
                    # 判据是「文件是否还在」，不是「这一次是不是我删的」。
                    try:
                        os.remove(os.path.join(path, rel))
                        pruned += 1
                    except FileNotFoundError:
                        pass
            print(f'    → 写入 {len(add) + len(changed)} 个' + (f'，删除 {pruned} 个' if args.prune else ''))
    print()
    return drift


if __name__ == '__main__':
    sys.exit(main())
