def parse_shared_pin(text: str, pkg_name: str) -> tuple[str, str | None, object]:
    """package.json 里对某个共享包的依赖行。

    返回三元组，第一项是状态：
    - ('absent', None, None)          —— 依赖表里根本没有这一条（不依赖它的仓，合法）；
    - ('ok', spec, ref)               —— 认识的两种历史写法之一：
                                          `git+ssh://git@github.com/…#<ref>` 或 `github:owner/repo#<ref>`，
                                          <ref> 可以是 sha 也可以是 tag；
    - ('bad', spec, line_no)          —— 有这一条但写法不认识。**这必须响亮报错**：
                                          写法认不出时若归入「未 pin」，钉子漂到哪儿都没人知道
                                          （automation 的 github: 简写钉子就这样静默漏检过一回）。
    """
    dep_re = re.compile(rf'"{re.escape(pkg_name)}"\s*:\s*"(?P<spec>[^"]*)"')
    m = dep_re.search(text)
    if not m:
        return 'absent', None, None
    spec = m.group('spec')
    form = re.fullmatch(
        r'(?:git\+ssh://git@github\.com/[^#\s]+|github:[^#\s]+)#(?P<ref>[A-Za-z0-9._/-]+)',
        spec,
    )
    if not form:
        return 'bad', spec, text[:m.start()].count('\n') + 1
    return 'ok', spec, form.group('ref')


def resolve_shared_ref(pkg_repo: str, ref: str) -> str | None:
    """把钉子引用（sha 或 tag）经**本机兄弟 checkout** 解析成 commit sha；解析不了返回 None。

    不走网络：tag → sha 的映射以 `<codes>/<pkg_repo>` 里的对象为准，annotated tag 经 ^{commit}
    剥到 commit。解析不了（tag 没 fetch / sha 不存在）由调用方判错，不在这里吞掉。
    """
    repo_dir = os.path.join(CODES, pkg_repo)
    proc = subprocess.run(
        ['git', '-C', repo_dir, 'rev-parse', '--verify', '--quiet', f'{ref}^{{commit}}'],
        capture_output=True, text=True,
    )
    if proc.returncode != 0:
        return None
    return proc.stdout.strip()


def latest_tag(pkg_repo: str) -> str | None:
    """共享包仓最近创建的 tag（翻转后的落后报告用）；无 tag 返回 None。"""
    out = git(os.path.join(CODES, pkg_repo), 'for-each-ref', 'refs/tags',
              '--sort=-creatordate', '--format=%(refname:short)').strip()
    return out.split('\n')[0] if out else None


