#!/usr/bin/env bash
# Hard admission gate for task creation/launch.
# This check is read-only: it never switches branches or repairs worktrees.
set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

failures=0
checked=0

for repo in aidcp aidcp-edge aidcp-cloud aidcp-console; do
  repo_root="$(repo_path "$repo")"
  expected_branch="$(_default_branch "$repo")"

  if [ ! -e "$repo_root/.git" ]; then
    echo "SKIP: ${repo} canonical checkout is not cloned at ${repo_root}" >&2
    continue
  fi

  checked=$((checked + 1))
  current_branch="$(git -C "$repo_root" symbolic-ref --short -q HEAD 2>/dev/null || true)"
  git_dir="$(git -C "$repo_root" rev-parse --git-dir 2>/dev/null || true)"

  if [[ "$git_dir" == */worktrees/* ]]; then
    echo "FAIL: ${repo} canonical path is a linked worktree: ${repo_root}" >&2
    failures=$((failures + 1))
    continue
  fi

  if [ -z "$current_branch" ]; then
    echo "FAIL: ${repo} canonical path is detached or has no symbolic branch: ${repo_root} (expected ${expected_branch})" >&2
    failures=$((failures + 1))
    continue
  fi

  if [ "$current_branch" != "$expected_branch" ]; then
    echo "FAIL: ${repo} canonical path is on ${current_branch}: ${repo_root} (expected ${expected_branch})" >&2
    failures=$((failures + 1))
    continue
  fi

  echo "OK: ${repo} canonical path is on ${expected_branch}: ${repo_root}" >&2

  # A present package with a missing npm binary shim is an incomplete/corrupted install, not an
  # intentionally uninstalled dependency tree. Catch it before a build fails with "command not found".
  for package_binary in "typescript:tsc" "tsx:tsx"; do
    package_name="${package_binary%%:*}"
    binary_name="${package_binary##*:}"
    if [ -f "${repo_root}/node_modules/${package_name}/package.json" ] \
      && [ ! -e "${repo_root}/node_modules/.bin/${binary_name}" ] \
      && [ ! -e "${repo_root}/node_modules/.bin/${binary_name}.cmd" ]; then
      echo "FAIL: ${repo} canonical dependency shim is missing: node_modules/.bin/${binary_name} (package ${package_name} is installed; run npm ci in ${repo_root})" >&2
      failures=$((failures + 1))
    fi
  done

  # Worktree dependencies must be physical, isolated directories. A symlink/Junction here is
  # especially dangerous on Windows: npm cleanup in the worktree can mutate the canonical target.
  if [ "$repo" != "aidcp" ]; then
    worktree_root="${CODES_DIR}/${repo}.wt"
    for dependency_path in "${worktree_root}"/*/node_modules; do
      if [ ! -L "$dependency_path" ]; then
        continue
      fi
      link_target="$(readlink "$dependency_path" 2>/dev/null || echo unknown)"
      echo "FAIL: ${repo} worktree has linked node_modules: ${dependency_path} -> ${link_target}" >&2
      failures=$((failures + 1))
    done
  fi
done

# Fact-source flip guard (openspec change invert-split-fact-source): once the split
# fact source is flipped, aidcp-cloud src/ + migrations/ are frozen at frozenCloudRef.
# Any drift there (committed, uncommitted, or untracked) means someone is still
# working in the retired replay model — block new tasks until it is moved or reverted.
fact_source_marker="$(dirname "${BASH_SOURCE[0]}")/fact-source.json"
if [ -f "$fact_source_marker" ]; then
  flipped="$(python3 -c 'import json,sys;d=json.load(open(sys.argv[1]));print("1" if d.get("flipped") else "0")' "$fact_source_marker" 2>/dev/null || echo 0)"
  if [ "$flipped" = "1" ]; then
    frozen_ref="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get("frozenCloudRef") or "")' "$fact_source_marker")"
    cloud_root="$(repo_path aidcp-cloud)"
    if [ -z "$frozen_ref" ]; then
      echo "FAIL: fact-source.json is flipped but frozenCloudRef is empty" >&2
      failures=$((failures + 1))
    elif [ ! -e "$cloud_root/.git" ]; then
      echo "SKIP: fact-source flip guard — aidcp-cloud is not cloned at ${cloud_root}" >&2
    elif ! git -C "$cloud_root" rev-parse --verify --quiet "${frozen_ref}^{commit}" >/dev/null; then
      echo "FAIL: frozenCloudRef ${frozen_ref} is not present in aidcp-cloud (git fetch?)" >&2
      failures=$((failures + 1))
    else
      frozen_drift="$({ git -C "$cloud_root" diff --name-only "$frozen_ref" -- src/ migrations/; \
                        git -C "$cloud_root" ls-files --others --exclude-standard -- src/ migrations/; } | sort -u)"
      if [ -n "$frozen_drift" ]; then
        echo "FAIL: fact source is flipped — aidcp-cloud src/+migrations/ are frozen at ${frozen_ref}, but drift exists:" >&2
        echo "$frozen_drift" | head -20 | sed 's/^/  /' >&2
        echo "  (edit the owning derived repo instead: aidcp-api / aidcp-automation / aidcp-content)" >&2
        failures=$((failures + 1))
      fi
    fi
  fi
fi

if [ "$checked" -eq 0 ]; then
  echo "ERROR: no canonical repositories are available for task admission" >&2
  exit 1
fi

if [ "$failures" -gt 0 ]; then
  cat >&2 <<'EOF'
ERROR: task admission blocked by canonical/worktree safety state.
Resolve the reported issue(s) first. Feature/release work belongs in an
isolated worktree, and every worktree must own its node_modules directory.
This guard will not switch branches, clean files, remove links, or override
another session.
EOF
  exit 1
fi

exit 0
