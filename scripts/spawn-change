#!/usr/bin/env bash
# Spawn a terminal-owned parallel dev stream: open the isolated worktree for a
# change, generate the session brief, and (with --launch) start `claude` in the
# control repo with that brief as the first message.
# Usage: spawn-change <aidcp-edge|aidcp-cloud|aidcp-console> <change-name> [--launch]
# See docs/parallel-dev-worktrees.md §3b (multi-terminal mode).
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

usage() {
cat >&2 <<EOF
usage: spawn-change <aidcp-edge|aidcp-cloud|aidcp-console> <change-name> [--launch]

  开一条「终端自有」的并行流：确保 ../<repo>.wt/<name> worktree 存在（缺则创建），
  生成该 change 的任务简报。默认只打印简报（复制进任意 claude session 即可）；
  --launch 则直接在中控仓启动 claude 并把简报作为首条消息。

  前提：change 应已 propose（openspec/changes/<name>/ 存在）；全新任务先在任一
  session 里 /opsx:propose 再 spawn。
EOF
exit 1
}

[ $# -ge 2 ] || usage
repo="$1"; name="$2"; launch="${3:-}"
require_subrepo "$repo"
repo_cloned "$repo" || die "$repo 未在本机 clone（见 CLAUDE.md §0）。"

wt="$(worktree_path "$repo" "$name")"

# 幂等：worktree 已在且分支同名则复用，否则走 new-change 全新开流
if [ -d "$wt" ]; then
  cur="$(git -C "$wt" symbolic-ref --quiet --short HEAD 2>/dev/null || echo '?')"
  [ "$cur" = "$name" ] || die "worktree 已存在但分支是 '${cur}' ≠ '${name}' ，先人工核对。"
  info "复用已有 worktree: ${wt}"
else
  "$_LIB_DIR/new-change" "$repo" "$name"
fi

change_active "$name" || warn "openspec change '${name}' 不存在于控制仓——先 propose，否则 session 无任务可读。"

PROMPT="实装 openspec change「${name}」（主目标仓 ${repo}）。你是并行 fleet 中独占本 change 的 session，按中控仓 CLAUDE.md §7 并行开发规范走全流程：

1. 先读 openspec/changes/${name}/ 下的 proposal.md / design.md（若有）/ tasks.md，定位待做 task；再读 docs/parallel-dev-worktrees.md §4。
2. 代码只改隔离 worktree ${wt} （分支 ${name} ，已开好）；绝不动子仓主 checkout。若本 change 还涉及其他子仓，用 scripts/new-change <那个仓> ${name} 开同名 worktree。
3. 热点文件红线：两份 protocol.ts、command-bridge.ts 动作映射、event-bus/types.ts 的 RoleName 穷举 + role-catalog 注册、risk-state-machine.ts——需要动就停手上报，不并行。
4. 在 worktree 里跑 test（有 test:acceptance 先跑）+ typecheck，全绿才算完；提交到本分支，message 前缀「${name}: 」。绝不静默假成功。
5. 集成：scripts/land-change ${repo} ${name} --yes（fetch+rebase→全量绿→ff 推送→清理；撞 non-ff 重跑，绝不 force）。
6. 回写 openspec/changes/${name}/tasks.md 进度（commit sha + 偏离说明）；真机验收类项登记 docs/real-machine-acceptance-backlog.md 对应簇（归档与真机解耦）；代码完成+部署后 openspec archive。
7. 如需部署：只从主 checkout、严格走 CLAUDE.md §5 安全序列，且部署前先探 ECS 现状（近 1h 文件 mtime + md5 对 master）避免撞并发部署；cloud/console 若有接口形状联动须同批上线。"

echo
echo "──────── 任务简报（复制给 session 或用 --launch 直接启动）────────"
echo "$PROMPT"
echo "────────────────────────────────────────────────────────────"

if [ "$launch" = "--launch" ]; then
  command -v claude >/dev/null 2>&1 || die "claude CLI 不在 PATH。"
  info "在中控仓启动 claude（读到 CLAUDE.md §7）..."
  cd "$CONTROL_REPO"
  exec claude "$PROMPT"
fi
